{
  "name": "typst-editor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typst-bundle": "cp node_modules/@myriaddreamin/typst.ts/dist/esm/contrib/all-in-one-lite.bundle.js ../typst/typst.bundle.js",
    "editor-bundle": "rollup -c rollup.config.mjs",
    "build": "pnpm run typst-bundle && pnpm run editor-bundle",
    "dev": "pnpm run editor-bundle --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.1",
    "@codemirror/language": "^6.2.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/state": "^6.0.1",
    "@codemirror/view": "^6.0.2",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.28.0"
  }
}