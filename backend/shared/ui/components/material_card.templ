package components

import (
	"github.com/goquizvibe/backend/shared/db"
	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/types"
)

templ MaterialCard(m types.MaterialWithURL, t locales.Translator, showActions bool) {
	<div class="overflow-hidden bg-white rounded-xl shadow-sm transition hover:shadow-md">
		<div class="p-6">
			<div class="flex justify-between items-start mb-4">
				<div class="flex items-center gap-2">
					<span class={ "px-2 py-1 rounded text-xs " + GetMaterialTypeClass(m.Type) }>
						{ m.Type }
					</span>
					<span class={ "px-2 py-1 rounded text-xs " + GetPermissionBadgeClass(string(m.Permission)) }>
						{ GetPermissionLabel(m.Permission, t) }
					</span>
				</div>
				<div class="flex items-center gap-2">
					if showActions {
						<button
							type="button"
							data-asset-type="learning_material"
							data-asset-id={ m.Material.ID.String() }
							onclick="openPermissionsModal()"
							class="text-gray-400 transition hover:text-indigo-600"
							title={ t.Share() }
						>
							<i class="fas fa-share-alt"></i>
						</button>
					}
					if showActions && (m.Permission == db.PermissionTypeOwner || m.Permission == db.PermissionTypeWrite) {
						<button
							hx-delete={ "/admin/learning-materials/" + m.Material.ID.String() }
							hx-confirm={ t.AreYouSureThisActionIsReversible() }
							class="text-gray-400 transition hover:text-red-600"
						>
							<i class="fas fa-trash"></i>
						</button>
					}
				</div>
			</div>
			<a href={ templ.URL("/admin/learning-materials/" + m.Material.ID.String()) } class="block">
				<h3 class="mb-2 text-lg font-semibold transition hover:text-indigo-600">{ m.Material.Title }</h3>
			</a>
			if m.Material.Description != "" {
				<p class="mb-4 text-sm text-gray-500">{ m.Material.Description }</p>
			}
			<div class="flex justify-between items-center">
				if m.Type == "typst" && m.PublicURL != "" {
					<a
						href={ templ.URL("/admin/learning-materials/" + m.Material.ID.String() + "/preview") }
						class="text-sm font-medium text-indigo-600 hover:text-indigo-800"
						target="_blank"
					>
						<i class="mr-1 fas fa-eye"></i>{ t.Preview() }
					</a>
				} else if m.PublicURL != "" {
					<a
						href={ templ.URL(m.PublicURL) }
						class="text-sm font-medium text-indigo-600 hover:text-indigo-800"
						target="_blank"
					>
						<i class="mr-1 fas fa-download"></i>{ t.Open() }
					</a>
				} else {
					<span class="text-sm text-gray-400">{ t.NoPreviewAvailable() }</span>
				}
				<span class="text-xs text-gray-400">
					{ m.Material.CreatedAt.Format("2006-01-02") }
				</span>
			</div>
		</div>
	</div>
}

func GetMaterialTypeClass(materialType string) string {
	switch materialType {
	case "typst":
		return "bg-purple-100 text-purple-700"
	case "resource":
		return "bg-green-100 text-green-700"
	default:
		return "bg-gray-100 text-gray-700"
	}
}

func GetPermissionBadgeClass(permission string) string {
	switch permission {
	case "owner":
		return "bg-purple-100 text-purple-700"
	case "write":
		return "bg-blue-100 text-blue-700"
	case "read":
		return "bg-gray-100 text-gray-700"
	default:
		return "bg-gray-100 text-gray-700"
	}
}

func GetPermissionLabel(permission db.PermissionType, t locales.Translator) string {
	switch permission {
	case db.PermissionTypeOwner:
		return t.Owner()
	case db.PermissionTypeWrite:
		return t.CanEdit()
	case db.PermissionTypeRead:
		return t.CanView()
	default:
		return t.CanView()
	}
}

templ MaterialCardGrid(materials []types.MaterialWithURL, t locales.Translator, showActions bool) {
	<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		for _, m := range materials {
			@MaterialCard(m, t, showActions)
		}
	</div>
}
