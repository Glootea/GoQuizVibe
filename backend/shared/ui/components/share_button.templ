package components

import "github.com/goquizvibe/backend/shared/locales"

templ ShareButton(assetType, assetID string, t locales.Translator) {
	<a
		href={ templ.URL("/admin/assets/" + assetType + "/" + assetID + "/permissions") }
		class="p-2 text-gray-500 hover:text-indigo-600 transition"
		title={ t.Share() }
	>
		<i class="fas fa-share-alt"></i>
	</a>
}

func PermissionBadgeClass(permission string) string {
	switch permission {
	case "owner":
		return "bg-purple-100 text-purple-700"
	case "write":
		return "bg-blue-100 text-blue-700"
	case "read":
		return "bg-gray-100 text-gray-700"
	default:
		return "bg-gray-100 text-gray-700"
	}
}

templ PermissionBadge(permission string, t locales.Translator) {
	<span class={ "px-2 py-1 rounded text-xs " + PermissionBadgeClass(permission) }>
		switch permission {
			case "owner":
				{ t.Owner() }
			case "write":
				{ t.CanEdit() }
			case "read":
				{ t.CanView() }
			default:
				{ permission }
		}
	</span>
}
