package ui

import (
	"fmt"

	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/models"
	"github.com/goquizvibe/backend/shared/types"
)

templ QuizEditPage(data types.AdminQuizEditData, t locales.Translator) {
	@BaseAdmin(t.Editing(data.Quiz.Title), data.User, t) {
		<div id="saveAlert" class="hidden fixed top-4 right-4 z-50 py-3 px-6 text-white bg-green-500 rounded-lg shadow-lg">
			<i class="mr-2 fas fa-check"></i>{ t.QuizSaved() }
		</div>
		<div id="errorAlert" class="hidden fixed top-4 right-4 z-50 py-3 px-6 text-white bg-red-500 rounded-lg shadow-lg">
			<i class="mr-2 fas fa-times"></i>{ t.SaveError() }
		</div>
		<div class="flex justify-between items-center mb-8">
			<div>
				<a href="/admin/quizzes" class="inline-block mb-2 text-sm text-indigo-600 hover:text-indigo-800">
					<i class="mr-1 fas fa-arrow-left"></i>{ t.ToQuizList() }
				</a>
				<h1 class="text-3xl font-bold">{ data.Quiz.Title }</h1>
			</div>
			<div class="flex gap-3">
				<button type="button" onclick="location.reload()" class="py-2 px-4 rounded-lg border border-gray-300 transition hover:bg-gray-50">
					{ t.Cancel() }
				</button>
				<button type="button" onclick="submitQuizForm()" class="py-2 px-6 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700">
					<i class="mr-2 fas fa-save"></i>{ t.SaveAll() }
				</button>
			</div>
		</div>
		<div class="grid gap-8 md:grid-cols-3">
			<div class="space-y-6 md:col-span-2">
				<div class="p-6 bg-white rounded-xl shadow-sm">
					<h2 class="mb-4 text-xl font-bold">{ t.QuizInformation() }</h2>
					<form id="quizEditForm" hx-put={ "/admin/quizzes/" + data.Quiz.ID.String() } hx-trigger="submit" hx-swap="none">
						<input type="hidden" name="intent" value="save_all"/>
						<div class="grid gap-4 md:grid-cols-2">
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Title() }</label>
								<input type="text" name="title" value={ data.Quiz.Title } required class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Subject() }</label>
								<input type="text" name="subject" value={ data.Quiz.Subject } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Class() }</label>
								<input type="number" name="grade" min="1" max="11" value={ fmt.Sprintf("%d", data.Quiz.Grade) } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.TimeMin() }</label>
								<input type="number" name="time_limit" min="0" value={ fmt.Sprintf("%d", data.Quiz.TimeLimit) } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div class="md:col-span-2">
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Description() }</label>
								<textarea name="description" rows="2" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500">{ data.Quiz.Description }</textarea>
							</div>
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Status() }</label>
								<select name="status" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500">
									<option value="available" selected?={ data.Quiz.Status == "available" }>{ t.Available() }</option>
									<option value="assigned" selected?={ data.Quiz.Status == "assigned" }>{ t.Assigned() }</option>
									<option value="completed" selected?={ data.Quiz.Status == "completed" }>{ t.Completed() }</option>
									<option value="archived" selected?={ data.Quiz.Status == "archived" }>{ t.Archived() }</option>
								</select>
							</div>
						</div>
					</form>
				</div>
				@QuestionsSection(data.Quiz, data.Questions, t)
			</div>
			<div class="space-y-6">
				@QuizStats(data.Questions, data.Quiz.TimeLimit, t)
				@QuizDangerZone(data.Quiz.ID.String(), t)
			</div>
		</div>
		<script src="/static/scripts/admin.js"></script>
	}
}

templ QuestionsSection(quiz *models.Quiz, questions []models.Question, t locales.Translator) {
	<div id="questions-section" class="p-6 bg-white rounded-xl shadow-sm">
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-xl font-bold">{ t.Question(len(questions)) }</h2>
			<button
				type="button"
				onclick="openImportModal()"
				class="py-2 px-4 text-sm text-indigo-600 bg-indigo-50 rounded-lg transition hover:bg-indigo-100"
			>
				<i class="mr-1 fas fa-file-import"></i>{ t.ImportQuestions() }
			</button>
		</div>
		if len(questions) == 0 {
			<div class="py-8 text-center text-gray-500">
				<i class="mb-4 text-4xl text-gray-300 fas fa-question-circle"></i>
				<p>{ t.NoQuestionsYet() }</p>
			</div>
		} else {
			<div id="questions-list" class="space-y-4">
				for i, q := range questions {
					@QuestionCard(q, i, quiz.ID.String(), t)
				}
			</div>
		}
		@AddQuestionButton(t)
		@AddQuestionForm(quiz.ID.String(), len(questions), t)
	</div>
	@ImportQuestionsModal(quiz.ID.String(), quiz.Title, t)
}

templ QuestionCard(q models.Question, index int, quizID string, t locales.Translator) {
	<div id={ "question-card-" + q.ID.String() } class="p-4 rounded-lg border">
		<div class="flex justify-between items-start mb-2">
			<div class="flex gap-2 items-center">
				<span class="py-1 px-2 text-sm font-medium text-gray-700 bg-gray-200 rounded">{ index + 1 }</span>
				<span class="py-1 px-2 text-sm text-indigo-700 bg-indigo-100 rounded">{ q.Type }</span>
				<span class="text-sm text-gray-500">{ q.Points } { t.Points() }</span>
			</div>
			<div
				hx-delete={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() }
				hx-target={ "#question-card-" + q.ID.String() }
				hx-swap="delete"
				hx-confirm={ t.DeleteQuestion() }
				class="inline"
			>
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				<button type="button" class="ml-2 text-sm text-red-600 hover:text-red-800">
					<i class="fas fa-trash"></i>
				</button>
			</div>
		</div>
		<p class="mb-2 text-gray-800">{ q.Text }</p>
		@QuestionImagesSection(q, quizID, t)
		if q.Type == models.QuestionTypeChoice && len(models.GetQuestionOptions(q)) > 0 {
			<div class="text-sm text-gray-600">
				<p class="font-medium">{ t.Options() }</p>
				for _, opt := range models.GetQuestionOptions(q) {
					<span class="inline-block py-1 px-2 mt-1 mr-1 bg-gray-100 rounded">{ opt }</span>
				}
			</div>
		}
		<div class="mt-2 text-sm">
			<p class="text-green-600"><i class="mr-1 fas fa-check"></i>{ t.Answer() } { q.CorrectAnswer }</p>
			if q.Explanation != "" {
				<p class="mt-1 text-gray-500"><i class="mr-1 fas fa-info-circle"></i>{ q.Explanation }</p>
			}
		</div>
		<div id={ "editForm_" + quizID + "_" + fmt.Sprintf("%d", index) } class="hidden pt-4 mt-4 border-t">
			<div>
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				@QuestionEditFields(q, t)
			</div>
			<div class="flex gap-2 justify-end mt-4">
				<button
					type="button"
					data-quiz-id={ quizID }
					data-question-id={ q.ID.String() }
					onclick="handleQuestionEditSubmit(event)"
					class="py-1 px-3 text-white bg-indigo-600 rounded transition hover:bg-indigo-700"
				>{ t.Save() }</button>
			</div>
		</div>
		<div class="flex gap-2 pt-3 mt-3 border-t">
			<button
				type="button"
				data-quiz-id={ quizID }
				data-index={ fmt.Sprintf("%d", index) }
				data-qid={ q.ID.String() }
				onclick="toggleEditForm(this.dataset.quizId, this.dataset.index)"
				class="text-sm text-indigo-600 hover:text-indigo-800"
			>
				<i class="mr-1 fas fa-edit"></i>{ t.Edit() }
			</button>
		</div>
	</div>
}

templ QuestionEditFields(q models.Question, t locales.Translator) {
	<div class="space-y-3">
		<div>
			<label class="block mb-1 text-sm font-medium text-gray-700">{ t.QuestionText() }</label>
			<input type="text" name="text" value={ q.Text } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Type() }</label>
				<select
					name="type"
					class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"
					onchange="updateAnswerOptions(this)"
					id="typeSelect"
				>
					<option value="choice" selected?={ q.Type == "choice" }>{ t.Choice() }</option>
					<option value="open" selected?={ q.Type == "open" }>{ t.Open() }</option>
					<option value="fill" selected?={ q.Type == "fill" }>{ t.Fill() }</option>
				</select>
			</div>
			<div>
				<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Points() }</label>
				<input type="number" name="points" min="1" value={ fmt.Sprintf("%d", q.Points) } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
			</div>
		</div>
		<div class="answer-options-container">
			@AnswerOptionsByType(q, t)
		</div>
		<div>
			<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Explanation() }</label>
			<input type="text" name="explanation" value={ q.Explanation } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
		</div>
	</div>
}

templ AnswerOptionsByType(q models.Question, t locales.Translator) {
	switch q.Type {
		case models.QuestionTypeOpen:
			<label class="block mb-1 text-sm font-medium text-gray-700">{ t.CorrectAnswer() }</label>
			<input type="text" name="correct_answer" value={ q.CorrectAnswer } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
		case models.QuestionTypeFill:
			<div class="fill-answer-editor">
				<label class="block mb-2 text-sm font-medium text-gray-700">Правильные ответы (сегменты)</label>
				<div id="segments-preview" class="p-3 mb-3 text-sm bg-gray-50 rounded-lg">
					@templ.Raw(fillSegmentsPreview(q.CorrectAnswer))
				</div>
				<div class="flex gap-2 mb-3">
					<button type="button" onclick="addSegment('text', 'segment-inputs')" class="py-1 px-3 text-sm bg-gray-100 rounded-lg border hover:bg-gray-200">
						<i class="mr-1 fas fa-font"></i>Добавить текст
					</button>
					<button type="button" onclick="addSegment('gap', 'segment-inputs')" class="py-1 px-3 text-sm bg-indigo-100 rounded-lg border border-indigo-300 hover:bg-indigo-200">
						<i class="mr-1 fas fa-question-circle"></i>Добавить пропуск
					</button>
				</div>
				<div id="segment-inputs" class="space-y-2" data-correct-answer={ q.CorrectAnswer }></div>
				<input type="hidden" name="segments_json" id="segments-json"/>
			</div>
			<script>
				document.addEventListener("DOMContentLoaded", function() {
					var container = document.getElementById("segment-inputs");
					if (container && container.dataset.correctAnswer) {
						setupFillAnswerEditor(container.dataset.correctAnswer);
					}
				});
			</script>
		case models.QuestionTypeChoice:
			<label class="block mb-1 text-sm font-medium text-gray-700">{ t.AnswerOptions() }</label>
			<div class="space-y-2 options-list">
				for i, opt := range models.GetQuestionOptions(q) {
					<div class="flex gap-2 items-center option-row">
						<input type="radio" name="correct_answer" value={ fmt.Sprintf("option_%d", i) } checked?={ opt == q.CorrectAnswer } class="w-4 h-4 text-indigo-600"/>
						<input type="text" name={ "option_" + fmt.Sprintf("%d", i) } value={ opt } class="flex-1 py-2 px-3 rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
						<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700">
							<i class="fas fa-times"></i>
						</button>
					</div>
				}
			</div>
			<button type="button" onclick="addOption(this)" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">
				<i class="mr-1 fas fa-plus"></i>{ t.AddOption() }
			</button>
	}
}

templ AddQuestionButton(t locales.Translator) {
	<button onclick="document.getElementById('addQuestionFormWrapper').classList.toggle('hidden')" class="py-3 mt-4 w-full text-gray-500 rounded-lg border-2 border-gray-300 border-dashed transition hover:text-indigo-600 hover:border-indigo-400">
		<i class="mr-2 fas fa-plus"></i>{ t.AddQuestion() }
	</button>
}

templ AddQuestionForm(quizID string, questionCount int, t locales.Translator) {
	<div id="addQuestionFormWrapper" class="hidden pt-4 mt-4 border-t">
		<div
			hx-post={ "/admin/quizzes/" + quizID + "/question" }
			hx-target="#questions-section"
			hx-swap="innerHTML"
			enctype="multipart/form-data"
		>
			<h3 class="mb-3 font-semibold">{ t.NewQuestion() }</h3>
			<div class="space-y-3">
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.QuestionText() }</label>
					<input type="text" name="text" required class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div class="grid grid-cols-3 gap-3">
					<div>
						<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Type() }</label>
						<select name="type" id="addFormTypeSelect" onchange="updateAddFormAnswerOptions(this)" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500">
							<option value="choice">{ t.Choice() }</option>
							<option value="open">{ t.Open() }</option>
							<option value="fill">{ t.Fill() }</option>
						</select>
					</div>
					<div>
						<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Points() }</label>
						<input type="number" name="points" min="1" value="10" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
					</div>
					<div>
						<label class="block mb-1 text-sm font-medium text-gray-700">#</label>
						<input type="number" name="order_index" min="0" value={ fmt.Sprintf("%d", questionCount) } class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
					</div>
				</div>
				<div id="addFormAnswerOptions">
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.CorrectAnswer() }</label>
					<input type="text" name="correct_answer" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Explanation() }</label>
					<input type="text" name="explanation" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.ImagesUpTo3() }</label>
					<input type="file" name="images" multiple accept=".jpg,.jpeg,.png,.webp" class="text-sm text-gray-500"/>
					<p class="mt-1 text-xs text-gray-500">{ t.JpgPngWebpUpTo5mbEach() }</p>
				</div>
			</div>
			<div class="flex gap-2 justify-end mt-4">
				<button type="button" onclick="document.getElementById('addQuestionFormWrapper').classList.add('hidden')" class="py-2 px-4 text-gray-600 hover:text-gray-800">
					{ t.Cancel() }
				</button>
				<button type="submit" class="py-2 px-4 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700">
					<i class="mr-2 fas fa-plus"></i>{ t.Add() }
				</button>
			</div>
		</div>
	</div>
}

templ QuizStats(questions []models.Question, timeLimit int, t locales.Translator) {
	<div class="p-6 bg-white rounded-xl shadow-sm">
		<h3 class="mb-4 font-bold">{ t.Statistics() }</h3>
		<div class="space-y-3">
			<div class="flex justify-between">
				<span class="text-gray-600">{ t.Question(0) }</span>
				<span class="font-semibold">{ len(questions) }</span>
			</div>
			<div class="flex justify-between">
				<span class="text-gray-600">{ t.TotalPoints() }</span>
				<span class="font-semibold">{ getTotalPoints(questions) }</span>
			</div>
			<div class="flex justify-between">
				<span class="text-gray-600">{ t.Time() }</span>
				<span class="font-semibold">{ timeLimit } { t.Min() }</span>
			</div>
		</div>
	</div>
}

templ QuizDangerZone(quizID string, t locales.Translator) {
	<div class="p-6 bg-white rounded-xl shadow-sm">
		<h3 class="mb-4 font-bold">{ t.DangerZone() }</h3>
		<div
			hx-delete={ "/admin/quizzes/" + quizID }
			hx-confirm={ t.AreYouSureThisActionIsReversible() }
			class="inline"
		>
			<button type="button" class="py-2 px-4 w-full text-red-600 bg-red-50 rounded-lg transition hover:bg-red-100">
				<i class="mr-2 fas fa-archive"></i>{ t.MoveToArchive() }
			</button>
		</div>
	</div>
}

func getTotalPoints(questions []models.Question) int {
	total := 0
	for _, q := range questions {
		total += q.Points
	}
	return total
}

templ QuestionImagesSection(q models.Question, quizID string, t locales.Translator) {
	<div class="mb-3">
		<div class="flex justify-between items-center mb-2">
			<span class="text-sm font-medium text-gray-700">{ t.ImagesUpTo3() } ({ len(q.Images) }/3)</span>
		</div>
		if len(q.Images) > 0 {
			<div class="flex flex-wrap gap-2 mb-2">
				for _, img := range q.Images {
					<div class="relative group">
						<img src={ img.Url } class="object-cover w-24 h-24 rounded-lg border"/>
						<button
							type="button"
							class="absolute -top-2 -right-2 w-6 h-6 text-xs text-white bg-red-500 rounded-full opacity-0 transition group-hover:opacity-100"
							data-delete-url={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() + "/image/" + img.ID.String() }
							onclick="deleteQuestionImage(this)"
						>
							<i class="fas fa-times"></i>
						</button>
					</div>
				}
			</div>
		}
		if len(q.Images) < 3 {
			<div class="flex gap-2 items-center">
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				<input
					type="file"
					name="image"
					accept=".jpg,.jpeg,.png,.webp"
					class="text-sm text-gray-500"
					data-upload-url={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() + "/image" }
					onchange="uploadQuestionImage(this)"
				/>
				<button type="button" class="py-1 px-3 text-sm text-indigo-700 bg-indigo-100 rounded transition hover:bg-indigo-200">
					<i class="mr-1 fas fa-upload"></i>{ t.Upload() }
				</button>
			</div>
		}
	</div>
}

templ ImportQuestionsModal(quizID string, quizTitle string, t locales.Translator) {
	<div id="importModal" class="flex hidden fixed inset-0 z-50 justify-center items-center bg-black bg-opacity-50">
		<div class="overflow-y-auto p-6 w-full max-w-2xl bg-white rounded-xl shadow-xl max-h-[90vh]">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-bold">{ t.ImportFromJson() }</h2>
				<button type="button" onclick="closeImportModal()" class="text-gray-500 hover:text-gray-700">
					<i class="text-xl fas fa-times"></i>
				</button>
			</div>
			<div class="space-y-4">
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Title() }</label>
					<input
						type="text"
						id="importQuizTitle"
						value={ quizTitle }
						class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500"
						oninput="updateImportPrompt()"
					/>
				</div>
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.PromptForLlmQuestionGeneration() }</label>
					<textarea
						id="promptTextarea"
						readonly
						rows="6"
						class="py-2 px-3 w-full font-mono text-sm bg-gray-50 rounded-lg border"
						placeholder={ t.EnterQuizTopicAboveToGeneratePrompt() }
					></textarea>
				</div>
				<div class="flex gap-2">
					<button
						type="button"
						onclick="downloadPrompt()"
						class="py-2 px-4 text-sm text-indigo-600 bg-indigo-50 rounded-lg transition hover:bg-indigo-100"
					>
						<i class="mr-1 fas fa-download"></i>{ t.DownloadPromptAsFile() }
					</button>
				</div>
				<div class="pt-4 border-t">
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.UploadJsonFile() }</label>
					<input
						type="file"
						id="jsonFileInput"
						accept=".json"
						class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"
						onchange="handleJSONFileUpload(this)"
					/>
				</div>
				<div class="text-center text-gray-500">— { t.OrEnterJsonManually() } —</div>
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Questions() }</label>
					<textarea
						id="manualJSONInput"
						rows="8"
						class="py-2 px-3 w-full font-mono text-sm rounded-lg border focus:ring-2 focus:ring-indigo-500"
						placeholder={ `[{"text": "...", "type": "choice", ...}, ...]` }
					></textarea>
				</div>
				<div id="importError" class="hidden text-sm text-red-600"></div>
				<div class="flex gap-2 justify-end pt-4 border-t">
					<button
						type="button"
						onclick="closeImportModal()"
						class="py-2 px-4 text-gray-600 hover:text-gray-800"
					>
						{ t.Cancel() }
					</button>
					<button
						type="button"
						onclick="importQuestions()"
						class="py-2 px-4 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700"
					>
						<i class="mr-1 fas fa-upload"></i>{ t.Import() }
					</button>
				</div>
			</div>
			<input type="hidden" id="importQuizID" value={ quizID }/>
		</div>
	</div>
}

// Refactor to templ component
func fillSegmentsPreview(correctAnswer string) string {
	segments, err := models.ParseFillSegments(correctAnswer)
	if err != nil || len(segments) == 0 {
		return `<span class="text-gray-400">Добавьте текст и пропуски</span>`
	}

	result := ""
	for _, seg := range segments {
		if seg.Type == "text" {
			result += seg.Content
		} else if seg.Type == "gap" {
			result += fmt.Sprintf(`<span class="py-0.5 px-2 mx-1 text-indigo-700 bg-indigo-100 rounded border border-indigo-300">%s</span>`, seg.Content)
		}
	}
	return result
}
