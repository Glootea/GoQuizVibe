package ui

import (
	"fmt"

	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/models"
	"github.com/goquizvibe/backend/shared/types"
)

templ QuizzesPage(data types.AdminQuizListData, t locales.Translator) {
	@BaseAdmin(t.Quizzes(), data.User, t) {
		<div class="flex justify-between items-center mb-8">
			<h1 class="text-3xl font-bold">{ t.QuizManagement() }</h1>
			<button onclick="document.getElementById('createModal').classList.remove('hidden')" class="py-2 px-4 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700">
				<i class="mr-2 fas fa-plus"></i>{ t.CreateQuiz() }
			</button>
		</div>
		if len(data.Quizzes) == 0 {
			<div class="p-12 text-center bg-white rounded-xl shadow-sm">
				<i class="mb-4 text-6xl text-gray-300 fas fa-folder-open"></i>
				<p class="text-lg text-gray-500">{ t.NoQuizzesAvailableYet() }</p>
				<button onclick="document.getElementById('createModal').classList.remove('hidden')" class="mt-4 text-indigo-600 hover:text-indigo-800">
					<i class="mr-1 fas fa-plus"></i>{ t.CreateFirstQuiz() }
				</button>
			</div>
		} else {
			<div class="overflow-hidden bg-white rounded-xl shadow-sm">
				<table class="w-full">
					<thead class="bg-gray-50 border-b">
						<tr>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Title() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Subject() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Class() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Question(0) }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Attempts() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.AvgScore() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Status() }</th>
							<th class="py-4 px-6 font-semibold text-right text-gray-600">{ t.Actions() }</th>
						</tr>
					</thead>
					<tbody class="divide-y">
						for _, quiz := range data.Quizzes {
							<tr class={ "hover:bg-gray-50 " + getRowClass(string(quiz.Status)) }>
								<td class="py-4 px-6">
									<p class={ "font-medium " + getTextClass(string(quiz.Status)) }>{ quiz.Title }</p>
									<p class="text-sm text-gray-500">{ quiz.Description }</p>
								</td>
								<td class="py-4 px-6">
									<span class="py-1 px-2 text-sm text-indigo-700 bg-indigo-100 rounded">{ quiz.Subject }</span>
								</td>
								<td class="py-4 px-6">{ quiz.Grade }</td>
								<td class="py-4 px-6">{ len(quiz.Questions) }</td>
								<td class="py-4 px-6">{ quiz.AttemptCount }</td>
								<td class="py-4 px-6">
									if quiz.AttemptCount > 0 {
										<span class={ getScoreClass(quiz.AvgScore) }>{ fmt.Sprintf("%.1f", quiz.AvgScore) }%</span>
									} else {
										<span class="text-gray-400">—</span>
									}
								</td>
								<td class="py-4 px-6">
									<span class={ "px-2 py-1 rounded text-sm " + getStatusClass(string(quiz.Status)) }>
										switch quiz.Status {
											case models.QuizStatusAvailable:
												{ t.Available() }
											case models.QuizStatusAssigned:
												{ t.Assigned() }
											case models.QuizStatusCompleted:
												{ t.Completed() }
											case models.QuizStatusArchived:
												{ t.Archived() }
										}
									</span>
								</td>
								<td class="py-4 px-6 text-right">
									<a href={ templ.URL("/admin/quizzes/" + quiz.ID.String()) } class="mr-3 text-indigo-600 hover:text-indigo-800">
										<i class="fas fa-edit"></i>
									</a>
									if quiz.Status == models.QuizStatusArchived {
										<form method="POST" action={ templ.URL("/admin/quizzes/" + quiz.ID.String() + "/restore") } class="inline">
											<button type="submit" class="text-green-600 hover:text-green-800">
												<i class="fas fa-undo"></i>
											</button>
										</form>
									} else {
										<div
											hx-delete={ "/admin/quizzes/" + quiz.ID.String() }
											hx-confirm={ t.DeleteQuiz() }
											class="inline"
										>
											<button type="button" class="text-red-600 hover:text-red-800">
												<i class="fas fa-trash"></i>
											</button>
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div id="createModal" class="flex hidden fixed inset-0 z-50 justify-center items-center bg-black bg-opacity-50">
			<div class="p-6 w-full max-w-md bg-white rounded-xl">
				<h3 class="mb-4 text-xl font-bold">{ t.CreateQuiz() }</h3>
				<form hx-post="/admin/quizzes/new" hx-target="body" hx-swap="none">
					<div class="space-y-4">
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Title() }</label>
							<input type="text" name="title" required class="py-2 px-3 w-full rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
						</div>
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Description() }</label>
							<textarea name="description" rows="2" class="py-2 px-3 w-full rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"></textarea>
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Subject() }</label>
								<input type="text" name="subject" placeholder="Математика" class="py-2 px-3 w-full rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Class() }</label>
								<input type="number" name="grade" min="1" max="11" value="5" class="py-2 px-3 w-full rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
							</div>
						</div>
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.TimeMin() }</label>
							<input type="number" name="time_limit" min="0" value="900" class="py-2 px-3 w-full rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
						</div>
					</div>
					<div class="flex gap-3 justify-end mt-6">
						<button type="button" onclick="document.getElementById('createModal').classList.add('hidden')" class="py-2 px-4 text-gray-600 hover:text-gray-800">
							{ t.Cancel() }
						</button>
						<button type="submit" class="py-2 px-4 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700">
							{ t.Create() }
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

func getScoreClass(score float64) string {
	if score >= 80 {
		return "text-green-600 font-semibold"
	} else if score >= 60 {
		return "text-yellow-600 font-semibold"
	}
	return "text-red-600 font-semibold"
}

func getStatusClass(status string) string {
	switch status {
	case "available":
		return "bg-green-100 text-green-700"
	case "assigned":
		return "bg-blue-100 text-blue-700"
	case "completed":
		return "bg-gray-100 text-gray-700"
	case "archived":
		return "bg-red-100 text-red-700"
	}
	return "bg-gray-100 text-gray-700"
}

func getRowClass(status string) string {
	if status == "archived" {
		return "bg-gray-100 opacity-60"
	}
	return ""
}

func getTextClass(status string) string {
	if status == "archived" {
		return "text-gray-400"
	}
	return "text-gray-900"
}
