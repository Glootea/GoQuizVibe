package ui

import (
	"context"
	"fmt"
	"io"
	"strconv"
	"strings"

	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/models"
	"github.com/goquizvibe/backend/shared/types"
)

templ QuestionCard(data *types.QuizPageData, t locales.Translator) {
	<div id="question-content" class="flex gap-6 w-full">
		<div class="flex-1 min-w-0">
			<div class="flex justify-between items-center mb-6">
				<span id="question-counter" class="text-sm font-medium text-indigo-600">{ t.QuestionOf(data.CurrentIndex + 1, data.TotalQuestions) }</span>
				@TimerWidget(data.Questions[0].QuizID, data.SessionID, data.RemainingSeconds)
			</div>
			<form
				id="quiz-form"
				class="w-full"
				hx-post={ "/quiz/" + data.Questions[0].QuizID.String() + "/navigate" }
				hx-target="#question-content"
				hx-swap="innerHTML"
			>
				<input type="hidden" name="current_index" value={ strconv.Itoa(data.CurrentIndex) } id="current-index"/>
				<input type="hidden" name="target_index" value={ strconv.Itoa(data.CurrentIndex + 1) } id="target-index"/>
				<div class="mb-4 w-full text-xl font-medium">
					if data.Questions[data.CurrentIndex].Type == models.QuestionTypeFill {
						@renderFillQuestionHTML(data.Questions[data.CurrentIndex].CorrectAnswer, data.Questions[data.CurrentIndex].Text, data.CurrentIndex, data.Answers)
					} else {
						{ data.Questions[data.CurrentIndex].Text }
					}
				</div>
				if len(data.Questions[data.CurrentIndex].Images) > 0 {
					<div class="flex flex-wrap gap-3 mb-6">
						for _, img := range data.Questions[data.CurrentIndex].Images {
							<img src={ img.Url } class="object-contain max-w-md max-h-64 rounded-lg border"/>
						}
					</div>
				}
				if data.Questions[data.CurrentIndex].Type == models.QuestionTypeChoice {
					<div class="space-y-3">
						if options, ok := data.AnswerOptions[data.CurrentIndex]; ok {
							for _, opt := range options {
								<label class="block p-4 rounded-xl border border-gray-200 transition cursor-pointer hover:bg-indigo-50 hover:border-indigo-300">
									<input
										type="radio"
										name="answer"
										value={ opt }
										class="mr-3"
										if data.Answers[data.CurrentIndex].Text == opt {
											checked
										}
									/>
									{ opt }
								</label>
							}
						}
					</div>
				} else if data.Questions[data.CurrentIndex].Type != models.QuestionTypeFill {
					<input
						type="text"
						name="answer"
						class="py-3 px-4 w-full rounded-xl border border-gray-300 transition outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"
						placeholder={ t.EnterYourAnswer() }
						value={ data.Answers[data.CurrentIndex].Text }
						required
					/>
				}
				if data.IsLastQuestion {
					<button
						type="button"
						id="submit-btn"
						class="py-3 mt-6 w-full font-semibold text-white bg-indigo-600 rounded-xl transition hover:bg-indigo-700"
						hx-post={ "/quiz/" + data.Questions[0].QuizID.String() + "/finish?session=" + data.SessionID }
						hx-confirm={ t.EndQuizThisActionCannotBeUndone() }
						hx-target="body"
						hx-swap="none"
						hx-include="#quiz-form"
					>
						{ t.Submit() }
					</button>
				} else {
					<button
						type="submit"
						class="py-3 mt-6 w-full font-semibold text-white bg-indigo-600 rounded-xl transition hover:bg-indigo-700"
					>
						{ t.Submit() }
					</button>
				}
			</form>
		</div>
		<div class="flex-shrink-0 w-64">
			<div class="sticky top-6 p-4 bg-white rounded-xl border border-gray-200 shadow-sm">
				<h3 class="mb-3 text-sm font-semibold text-gray-700">{ t.Questions() }</h3>
				<div class="grid grid-cols-5 gap-2">
					for i := 0; i < data.TotalQuestions; i++ {
						<button
							type="button"
							class={ getQuestionNavClass(i, data.CurrentIndex, data.Answers) }
							hx-post={ "/quiz/" + data.Questions[0].QuizID.String() + "/navigate" }
							hx-target="#question-content"
							hx-swap="innerHTML"
							hx-include="#quiz-form"
							hx-vars={ fmt.Sprintf("'current_index':'%d','target_index':'%d'", data.CurrentIndex, i) }
							title={ t.Question(i + 1) }
						>
							if i == data.CurrentIndex {
								◐
							} else if data.Answers[i].Answered {
								●
							} else {
								○
							}
						</button>
					}
				</div>
			</div>
		</div>
	</div>
}

func renderFillQuestionHTML(correctAnswer, fallbackText string, questionIndex int, answers map[int]types.AnswerState) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		segments, err := models.ParseFillSegments(correctAnswer)
		if err != nil || len(segments) == 0 {
			ansVal := ""
			if answers[questionIndex].Answered {
				ansVal = answers[questionIndex].Text
			}
			_, err = fmt.Fprintf(w, `%s<input type="text" name="gap_0" value="%s" class="inline py-1 px-2 mx-1 w-32 rounded-lg border border-indigo-300 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500" placeholder="..."/>`, fallbackText, ansVal)
			return err
		}

		gapIdx := 0
		storedAnswers := []string{}
		if answers[questionIndex].Answered {
			storedAnswers = strings.Split(answers[questionIndex].Text, "|")
		}

		for _, seg := range segments {
			if seg.Type == "text" {
				_, err = io.WriteString(w, seg.Content)
				if err != nil {
					return err
				}
			} else if seg.Type == "gap" {
				ansVal := ""
				if gapIdx < len(storedAnswers) {
					ansVal = storedAnswers[gapIdx]
				}
				_, err = fmt.Fprintf(w, `<input type="text" name="gap_%d" value="%s" class="inline py-1 px-2 mx-1 w-32 rounded-lg border border-indigo-300 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500" placeholder="..."/>`, gapIdx, ansVal)
				if err != nil {
					return err
				}
				gapIdx++
			}
		}
		return nil
	})
}

func getQuestionNavClass(index int, currentIndex int, answers map[int]types.AnswerState) string {
	base := "w-10 h-10 rounded-lg font-medium text-sm transition "
	if index == currentIndex {
		return base + "bg-indigo-100 border-2 border-indigo-500 text-indigo-700"
	}
	if answers[index].Answered {
		return base + "bg-green-100 border border-green-300 text-green-700 hover:bg-green-200"
	}
	return base + "bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200"
}
