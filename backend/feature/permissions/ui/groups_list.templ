package ui

import (
	"github.com/goquizvibe/backend/shared/db"
	"github.com/goquizvibe/backend/shared/locales"
)

templ GroupsListPage(groups []db.UserGroup, user *db.User, t locales.Translator) {
	@BaseAdmin(t.MyGroups(), user, t) {
		<div class="flex justify-between items-center mb-8">
			<h1 class="text-3xl font-bold">{ t.MyGroups() }</h1>
			<button
				onclick="document.getElementById('createGroupModal').classList.remove('hidden')"
				class="py-2 px-4 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700"
			>
				<i class="mr-2 fas fa-plus"></i>{ t.CreateGroup() }
			</button>
		</div>
		if len(groups) == 0 {
			<div class="p-12 text-center bg-white rounded-xl shadow-sm">
				<i class="mb-4 text-6xl text-gray-300 fas fa-users"></i>
				<p class="text-lg text-gray-500">{ t.NoGroupsYet() }</p>
				<button
					onclick="document.getElementById('createGroupModal').classList.remove('hidden')"
					class="mt-4 test-indigo-600 hover:text-indigo-800"
				>
					<i class="mr-1 fas fa-plus"></i>{ t.CreateGroup() }
				</button>
			</div>
		} else {
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				for _, group := range groups {
					<div class="bg-white rounded-xl shadow-sm p-6 hover:shadow-md transition">
						<div class="flex justify-between items-start mb-4">
							<a href={ templ.URL("/admin/groups/" + group.ID.String()) } class="block">
								<h3 class="text-lg font-semibold hover:text-indigo-600">{ group.Name }</h3>
							</a>
							<button
								hx-delete={ "/admin/groups/" + group.ID.String() }
								hx-confirm={ t.DeleteGroup() }
								hx-swap="none"
								class="text-gray-400 hover:text-red-600 transition"
							>
								<i class="fas fa-trash"></i>
							</button>
						</div>
						if group.Description != "" {
							<p class="text-sm text-gray-500 mb-4">{ group.Description }</p>
						}
						<div class="flex justify-between items-center text-sm text-gray-400">
							<span>{ group.CreatedAt.Format("2006-01-02") }</span>
							<a href={ templ.URL("/admin/groups/" + group.ID.String()) } class="text-indigo-600 hover:text-indigo-800">
								<i class="fas fa-arrow-right"></i>
							</a>
						</div>
					</div>
				}
			</div>
		}
		<div id="createGroupModal" class="flex hidden fixed inset-0 z-50 justify-center items-center bg-black bg-opacity-50">
			<div class="p-6 w-full max-w-md bg-white rounded-xl">
				<h3 class="mb-4 text-xl font-bold">{ t.CreateGroup() }</h3>
				<form hx-post="/admin/groups/new" hx-target="body" hx-swap="none">
					<div class="space-y-4">
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.GroupName() }</label>
							<input type="text" name="name" required class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
						</div>
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Description() }</label>
							<textarea name="description" rows="2" class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"></textarea>
						</div>
					</div>
					<div class="flex gap-3 justify-end mt-6">
						<button type="button" onclick="document.getElementById('createGroupModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800">
							{ t.Cancel() }
						</button>
						<button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
							{ t.Create() }
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}
