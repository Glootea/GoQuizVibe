package ui

import (
	"fmt"

	"github.com/goquizvibe/backend/feature/permissions/services"
	"github.com/goquizvibe/backend/shared/db"
	"github.com/goquizvibe/backend/shared/locales"
)

templ PermissionsModal(assetType, assetID string, permissions []services.PermissionWithGrantor, groups []db.UserGroup, t locales.Translator) {
	<div id="permissionsModal" data-asset-type={ assetType } data-asset-id={ assetID } class="flex fixed inset-0 z-50 justify-center items-center bg-black bg-opacity-50" style="display: none;">
		<div class="p-6 w-full max-w-lg bg-white rounded-xl max-h-[90vh] overflow-y-auto">
			<h3 class="mb-4 text-xl font-bold">{ t.Permissions() }</h3>
			
			<div id="permissions-list" class="mb-6">
				if len(permissions) == 0 {
					<p class="text-gray-500 text-center py-4">{ t.NoPermissionsYet() }</p>
				} else {
					<div class="space-y-2">
						for _, perm := range permissions {
							<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
								<div class="flex items-center gap-3">
									<i class="fas fa-share-alt text-gray-400"></i>
									<div>
										<span class="font-medium">{ fmt.Sprintf("%v", perm.RecipientName) }</span>
										<span class="text-sm text-gray-500 ml-2">
											if string(perm.RecipientType) == "group" {
												{ t.Group() }
											} else {
												{ t.User() }
											}
										</span>
									</div>
								</div>
								<div class="flex items-center gap-2">
									<span class={ "px-2 py-1 text-xs rounded " + PermissionBadgeClass(string(perm.Permission)) }>
										switch string(perm.Permission) {
										case "owner":
											{ t.Owner() }
										case "write":
											{ t.CanEdit() }
										case "read":
											{ t.CanView() }
										}
									</span>
									if string(perm.Permission) != "owner" {
										<form hx-delete={ "/admin/assets/" + assetType + "/" + assetID + "/permissions" } hx-swap="none" class="inline">
											<input type="hidden" name="recipient_type" value={ string(perm.RecipientType) }/>
											<input type="hidden" name="recipient_id" value={ perm.RecipientID.String() }/>
											<input type="hidden" name="permission" value={ string(perm.Permission) }/>
											<button type="submit" class="text-red-600 hover:text-red-800 transition">
												<i class="fas fa-times"></i>
											</button>
										</form>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="border-t pt-4">
				<h4 class="font-semibold mb-3">{ t.GrantAccess() }</h4>
				<form hx-post={ "/admin/assets/" + assetType + "/" + assetID + "/permissions" } hx-target="body" hx-swap="none">
					<div class="space-y-3">
						<div class="flex gap-2">
							<button type="button" data-recipient-type="user" onclick="selectRecipientType(this)" class="flex-1 px-3 py-2 rounded border recipient-type-btn selected">
								{ t.User() }
							</button>
							<button type="button" data-recipient-type="group" onclick="selectRecipientType(this)" class="flex-1 px-3 py-2 rounded border recipient-type-btn">
								{ t.Group() }
							</button>
						</div>
						<input type="hidden" name="recipient_type" id="recipientType" value="user"/>
						
						<div id="user-input">
							<input type="email" name="email" placeholder={ t.SearchByEmail() } class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
						</div>
						
						<div id="group-input" class="hidden">
							<select name="group_id" class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500">
								<option value="">{ t.SelectGroup() }</option>
								for _, g := range groups {
									<option value={ g.ID.String() }>{ g.Name }</option>
								}
							</select>
						</div>
						
						<div>
							<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Access() }</label>
							<select name="permission" class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500">
								<option value="read">{ t.CanView() }</option>
								<option value="write">{ t.CanEdit() }</option>
							</select>
						</div>
					</div>
					<div class="flex gap-3 justify-end mt-4">
						<button type="button" onclick="closePermissionsModal()" class="px-4 py-2 text-gray-600 hover:text-gray-800">
							{ t.Cancel() }
						</button>
						<button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
							{ t.GrantAccess() }
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

func PermissionBadgeClass(permission string) string {
	switch permission {
	case "owner":
		return "bg-purple-100 text-purple-700"
	case "write":
		return "bg-blue-100 text-blue-700"
	case "read":
		return "bg-gray-100 text-gray-700"
	default:
		return "bg-gray-100 text-gray-700"
	}
}
