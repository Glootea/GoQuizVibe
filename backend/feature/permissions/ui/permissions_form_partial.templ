package ui

import (
	"github.com/goquizvibe/backend/shared/db"
	"github.com/goquizvibe/backend/shared/locales"
)

templ GrantAccessForm(assetType, assetID string, groups []db.UserGroup, errorMsg string, t locales.Translator) {
	<div class="p-6 bg-white rounded-xl shadow-sm">
		<h2 class="mb-4 text-xl font-bold">{ t.GrantAccess() }</h2>
		if errorMsg != "" {
			<div class="p-4 mb-4 bg-red-50 text-red-700 rounded-lg border border-red-200 flex items-center gap-2">
				<i class="fas fa-exclamation-circle"></i>
				<span>{ errorMsg }</span>
			</div>
		}
		<form
			hx-post={ "/admin/assets/" + assetType + "/" + assetID + "/permissions" }
			hx-target="#permissions-form-container"
			hx-swap="innerHTML"
		>
			<div class="space-y-4">
				<div class="flex gap-2">
					<button type="button" data-recipient-type="user" onclick="selectRecipientType(this)" class="flex-1 px-3 py-2 rounded border recipient-type-btn selected">
						{ t.User() }
					</button>
					<button type="button" data-recipient-type="group" onclick="selectRecipientType(this)" class="flex-1 px-3 py-2 rounded border recipient-type-btn">
						{ t.Group() }
					</button>
				</div>
				<input type="hidden" name="recipient_type" id="recipientType" value="user"/>
				<div id="user-input">
					<input type="email" name="email" placeholder={ t.SearchByEmail() } class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div id="group-input" class="hidden">
					<select name="group_id" class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500">
						<option value="">{ t.SelectGroup() }</option>
						for _, g := range groups {
							<option value={ g.ID.String() }>{ g.Name }</option>
						}
					</select>
				</div>
				<div>
					<label class="block mb-1 text-sm font-medium text-gray-700">{ t.Access() }</label>
					<select name="permission" class="w-full px-3 py-2 rounded-lg border focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500">
						<option value="read">{ t.CanView() }</option>
						<option value="write">{ t.CanEdit() }</option>
					</select>
				</div>
			</div>
			<div class="flex gap-3 justify-end mt-4">
				<button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
					{ t.GrantAccess() }
				</button>
			</div>
		</form>
	</div>
}