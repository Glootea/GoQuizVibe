package ui

import (
	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/db"
)

templ LearningMaterialsPreviewPage(user *db.User, material *db.LearningMaterial, url string, t locales.Translator) {
	@BaseAdmin(t.PdfPreview()+" - "+material.Title, user, t) {
		<div class="p-8 min-h-screen bg-gray-100">
			<div class="mx-auto max-w-6xl">
				<div class="p-6 mb-6 bg-white rounded-xl shadow-sm">
					<div class="flex justify-between items-center">
						<div>
							<h1 class="text-2xl font-bold">{ material.Title }</h1>
							<p class="text-gray-500">{ t.PdfPreview() }</p>
						</div>
						<a
							href={ "/admin/learning-materials/" + templ.URL(material.ID.String()) }
							class="py-2 px-4 text-indigo-600 rounded-lg border border-indigo-600 transition hover:bg-indigo-50"
						>
							<i class="mr-1 fas fa-arrow-left"></i>{ t.BackToEdit() }
						</a>
					</div>
				</div>
				<div class="flex justify-center items-center p-8 bg-white rounded-xl shadow-sm">
					if url != "" {
						<iframe
							src={ templ.URL(url) }
							class="w-full h-dvh"
						></iframe>
					} else {
						<div class="text-center text-gray-500">
							<i class="mb-4 text-6xl text-gray-300 fas fa-file-code"></i>
							<p>{ t.PreviewNotAvailable() }</p>
						</div>
					}
				</div>
			</div>
		</div>
	}
}
