package ui

import (
	"github.com/goquizvibe/backend/shared/locales"
	"github.com/goquizvibe/backend/shared/db"
)

templ LearningMaterialsNewPage(user *db.User, t locales.Translator) {
	@BaseAdmin(t.CreateLearningMaterial(), user, t) {
		<div class="mx-auto max-w-2xl">
			<h1 class="mb-8 text-3xl font-bold">{ t.CreateLearningMaterial() }</h1>
			<div class="p-6 bg-white rounded-xl shadow-sm">
				<form
					hx-post="/admin/learning-materials/new"
					enctype="multipart/form-data"
					class="space-y-6"
				>
					<div>
						<label class="block mb-2 text-sm font-medium text-gray-700">{ t.Title() }</label>
						<input
							type="text"
							name="title"
							required
							class="py-2 px-4 w-full rounded-lg border border-gray-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"
							placeholder={ t.LearningMaterialTitlePlaceholder() }
						/>
					</div>
					<div>
						<label class="block mb-2 text-sm font-medium text-gray-700">{ t.Description() }</label>
						<textarea
							name="description"
							rows="3"
							class="py-2 px-4 w-full rounded-lg border border-gray-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"
							placeholder={ t.LearningMaterialDescriptionPlaceholder() }
						></textarea>
					</div>
					<div>
						<label class="block mb-2 text-sm font-medium text-gray-700">{ t.MaterialType() }</label>
						<div class="flex gap-4">
							<label class="flex items-center p-4 rounded-lg border border-gray-300 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
								<input type="radio" name="type" value="typst" class="mr-3" required/>
								<div>
									<span class="font-medium">{ t.TypstSource() }</span>
									<p class="text-sm text-gray-500">{ t.TypstSourceDescription() }</p>
								</div>
							</label>
							<label class="flex items-center p-4 rounded-lg border border-gray-300 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
								<input type="radio" name="type" value="resource" class="mr-3"/>
								<div>
									<span class="font-medium">{ t.ReadyResource() }</span>
									<p class="text-sm text-gray-500">{ t.ReadyResourceDescription() }</p>
								</div>
							</label>
						</div>
					</div>
					<div id="typst-files-section" class="hidden">
						<div class="mb-4">
							<label class="block mb-2 text-sm font-medium text-gray-700">{ t.TypstFiles() }</label>
							<input
								type="file"
								name="files"
								multiple
								accept=".typ"
								class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:border file:border-gray-300 file:rounded-lg file:text-sm file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100"
							/>
							<p class="mt-1 text-xs text-gray-500">{ t.TypstFilesHelp() }</p>
						</div>
						<p class="mb-4 text-center text-gray-500">{ t.Oruploadorcreate() }</p>
						<div>
							<button
								type="submit"
								name="typst_action"
								value="template"
								class="py-3 px-4 w-full font-medium text-indigo-700 rounded-lg border border-indigo-300 transition hover:bg-indigo-50"
							>
								{ t.CreateFromTemplate() }
							</button>
							<p class="mt-1 text-xs text-center text-gray-500">{ t.TemplateDescription() }</p>
						</div>
					</div>
					<div id="resource-file-section" class="hidden">
						<label class="block mb-2 text-sm font-medium text-gray-700">{ t.ResourceFile() }</label>
						<input
							type="file"
							name="file"
							accept=".jpg,.jpeg,.pdf"
							class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:border file:border-gray-300 file:rounded-lg file:text-sm file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100"
						/>
						<p class="mt-1 text-xs text-gray-500">{ t.ResourceFileHelp() }</p>
					</div>
					<div class="flex gap-4">
						<button
							type="submit"
							class="py-2 px-6 text-white bg-indigo-600 rounded-lg transition hover:bg-indigo-700"
						>
							{ t.Create() }
						</button>
						<a
							href="/admin/learning-materials"
							class="py-2 px-6 text-gray-700 bg-gray-100 rounded-lg transition hover:bg-gray-200"
						>
							{ t.Cancel() }
						</a>
					</div>
				</form>
			</div>
		</div>
		<script>
			document.querySelectorAll('input[name="type"]').forEach(function(radio) {
				radio.addEventListener('change', function() {
					document.getElementById('typst-files-section').classList.toggle('hidden', this.value !== 'typst');
					document.getElementById('resource-file-section').classList.toggle('hidden', this.value !== 'resource');
				});
			});
		</script>
	}
}
