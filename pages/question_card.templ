package pages

import (
	"strconv"

	"github.com/goquizvibe/models"
)

templ QuestionCard(quiz *models.Quiz, questionIndex int, sessionID string) {
	<div id="question-content">
		<div class="mb-6">
			<span id="question-counter" class="text-sm font-medium text-indigo-600">Вопрос { questionIndex + 1 } из { len(quiz.Questions) }</span>
		</div>
		<form
			id="quiz-form"
			hx-post={ "/quiz/" + quiz.ID.String() + "/submit?session=" + sessionID }
			hx-target="#question-content"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="question_index" value={ strconv.Itoa(questionIndex) }/>
			<div class="mb-4 text-xl font-medium">
				{ quiz.Questions[questionIndex].Text }
			</div>
			if len(quiz.Questions[questionIndex].Images) > 0 {
				<div class="flex flex-wrap gap-3 mb-6">
					for _, img := range quiz.Questions[questionIndex].Images {
						<img src={ img.Url } class="object-contain max-w-md max-h-64 rounded-lg border"/>
					}
				</div>
			}
			if quiz.Questions[questionIndex].Type == models.QuestionTypeChoice {
				<div class="space-y-3">
					for _, option := range quiz.Questions[questionIndex].GetOptions() {
						<label class="block p-4 rounded-xl border border-gray-200 transition cursor-pointer hover:bg-indigo-50 hover:border-indigo-300">
							<input
								type="radio"
								name="answer"
								value={ option }
								class="mr-3"
								required
							/>
							{ option }
						</label>
					}
				</div>
			} else {
				<input
					type="text"
					name="answer"
					class="py-3 px-4 w-full rounded-xl border border-gray-300 transition outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500"
					placeholder="Введите ответ..."
					required
				/>
			}
			<button
				type="submit"
				class="py-3 mt-6 w-full font-semibold text-white bg-indigo-600 rounded-xl transition hover:bg-indigo-700"
			>
				Ответить
			</button>
		</form>
	</div>
}

templ QuestionWithFeedback(quiz *models.Quiz, questionIndex int, sessionID string, feedback *QuestionFeedbackData) {
	<div id="question-content">
		<div class="p-4 mb-4 bg-green-50 rounded-xl border border-green-200">
			<div class="flex gap-2 items-center mb-2">
				<i class="text-green-600 fas fa-check-circle"></i>
				<span class="font-semibold text-green-700">Правильно!</span>
			</div>
			if feedback != nil && feedback.Explanation != "" {
				<p class="text-sm text-gray-600">{ feedback.Explanation }</p>
			}
		</div>
		if !feedback.IsLast {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) + "?session=" + sessionID) }
					class="block py-3 w-full font-semibold text-center text-white bg-indigo-600 rounded-xl transition hover:bg-indigo-700"
					hx-get={ "/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) + "?session=" + sessionID }
					hx-target="#question-content"
					hx-swap="innerHTML"
					hx-push-url={ "/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) }
				>
					Следующий вопрос
				</a>
			</div>
		} else {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/result?session=" + sessionID) }
					class="block py-3 w-full font-semibold text-center text-white bg-green-600 rounded-xl transition hover:bg-green-700"
				>
					Завершить тест
				</a>
			</div>
		}
	</div>
}

templ QuestionWithWrongFeedback(quiz *models.Quiz, questionIndex int, sessionID string, feedback *QuestionFeedbackData) {
	<div id="question-content">
		<div class="p-4 mb-4 bg-red-50 rounded-xl border border-red-200">
			<div class="flex gap-2 items-center mb-2">
				<i class="text-red-600 fas fa-times-circle"></i>
				<span class="font-semibold text-red-700">Неправильно</span>
			</div>
			<p class="mb-2 text-sm text-gray-600">Правильный ответ: { feedback.CorrectAnswer }</p>
			if feedback.Explanation != "" {
				<p class="text-sm text-gray-600">{ feedback.Explanation }</p>
			}
		</div>
		if !feedback.IsLast {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) + "?session=" + sessionID) }
					class="block py-3 w-full font-semibold text-center text-white bg-indigo-600 rounded-xl transition hover:bg-indigo-700"
					hx-get={ "/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) + "?session=" + sessionID }
					hx-target="#question-content"
					hx-swap="innerHTML"
					hx-push-url={ "/quiz/" + quiz.ID.String() + "/q/" + strconv.Itoa(questionIndex+1) }
				>
					Следующий вопрос
				</a>
			</div>
		} else {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/result?session=" + sessionID) }
					class="block py-3 w-full font-semibold text-center text-white bg-green-600 rounded-xl transition hover:bg-green-700"
				>
					Завершить тест
				</a>
			</div>
		}
	</div>
}

type QuestionFeedbackData struct {
	IsCorrect     bool
	CorrectAnswer string
	Explanation   string
	IsLast        bool
}
