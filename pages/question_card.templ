package pages

import (
	"strconv"

	"github.com/goquizvibe/models"
)

templ QuestionCard(quiz *models.Quiz, questionIndex int, sessionID string) {
	<div id="question-content">
		<div class="mb-6">
			<span id="question-counter" class="text-sm text-indigo-600 font-medium">Вопрос { questionIndex + 1 } из { len(quiz.Questions) }</span>
		</div>

		<form
			id="quiz-form"
			hx-post={ "/quiz/" + quiz.ID.String() + "/submit?session=" + sessionID }
			hx-target="#question-content"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="question_index" value={ strconv.Itoa(questionIndex) }/>

			<div class="text-xl font-medium mb-4">
				{ quiz.Questions[questionIndex].Text }
			</div>

			if len(quiz.Questions[questionIndex].Images) > 0 {
				<div class="flex flex-wrap gap-3 mb-6">
					for _, img := range quiz.Questions[questionIndex].Images {
						<img src={ img.URL } class="max-w-md max-h-64 object-contain rounded-lg border"/>
					}
				</div>
			}

			if quiz.Questions[questionIndex].Type == models.QuestionTypeChoice {
				<div class="space-y-3">
					for _, option := range quiz.Questions[questionIndex].GetOptions() {
						<label class="block p-4 border border-gray-200 rounded-xl cursor-pointer hover:bg-indigo-50 hover:border-indigo-300 transition">
							<input
								type="radio"
								name="answer"
								value={ option }
								class="mr-3"
								required
							/>
							{ option }
						</label>
					}
				</div>
			} else {
				<input
					type="text"
					name="answer"
					class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
					placeholder="Введите ответ..."
					required
				/>
			}

			<button
				type="submit"
				class="w-full mt-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition"
			>
				Ответить
			</button>
		</form>
	</div>
}

templ QuestionWithFeedback(quiz *models.Quiz, questionIndex int, sessionID string, feedback *QuestionFeedbackData) {
	<div id="question-content">
		<div class="mb-4 p-4 rounded-xl bg-green-50 border border-green-200">
			<div class="flex items-center gap-2 mb-2">
				<i class="fas fa-check-circle text-green-600"></i>
				<span class="font-semibold text-green-700">Правильно!</span>
			</div>
			if feedback != nil && feedback.Explanation != "" {
				<p class="text-sm text-gray-600">{ feedback.Explanation }</p>
			}
		</div>

		if !feedback.IsLast {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/next?session=" + sessionID + "&index=" + strconv.Itoa(questionIndex+1)) }
					class="block w-full py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition text-center"
					hx-get={ "/quiz/" + quiz.ID.String() + "/next?session=" + sessionID + "&index=" + strconv.Itoa(questionIndex+1) }
					hx-target="#question-content"
					hx-swap="innerHTML"
				>
					Следующий вопрос
				</a>
			</div>
		} else {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/result?session=" + sessionID) }
					class="block w-full py-3 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition text-center"
				>
					Завершить тест
				</a>
			</div>
		}
	</div>
}

templ QuestionWithWrongFeedback(quiz *models.Quiz, questionIndex int, sessionID string, feedback *QuestionFeedbackData) {
	<div id="question-content">
		<div class="mb-4 p-4 rounded-xl bg-red-50 border border-red-200">
			<div class="flex items-center gap-2 mb-2">
				<i class="fas fa-times-circle text-red-600"></i>
				<span class="font-semibold text-red-700">Неправильно</span>
			</div>
			<p class="text-sm text-gray-600 mb-2">Правильный ответ: { feedback.CorrectAnswer }</p>
			if feedback.Explanation != "" {
				<p class="text-sm text-gray-600">{ feedback.Explanation }</p>
			}
		</div>

		if !feedback.IsLast {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/next?session=" + sessionID + "&index=" + strconv.Itoa(questionIndex+1)) }
					class="block w-full py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition text-center"
					hx-get={ "/quiz/" + quiz.ID.String() + "/next?session=" + sessionID + "&index=" + strconv.Itoa(questionIndex+1) }
					hx-target="#question-content"
					hx-swap="innerHTML"
				>
					Следующий вопрос
				</a>
			</div>
		} else {
			<div class="mt-4">
				<a
					href={ templ.URL("/quiz/" + quiz.ID.String() + "/result?session=" + sessionID) }
					class="block w-full py-3 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition text-center"
				>
					Завершить тест
				</a>
			</div>
		}
	</div>
}

type QuestionFeedbackData struct {
	IsCorrect     bool
	CorrectAnswer string
	Explanation   string
	IsLast        bool
}