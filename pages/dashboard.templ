package pages

import (
	"github.com/goquizvibe/models"
	"github.com/goquizvibe/types"
)

templ DashboardPage(data types.DashboardData) {
	@Base("Панель") {
		@Navbar(data.User)

		<main class="max-w-6xl mx-auto px-4 py-8">
			@StatsCards(data.Stats)
			@QuizGrid(data.Quizzes)
			@LeaderboardPreview(data.Leaderboard)
		</main>
	}
}

templ Navbar(user *models.User) {
	<nav class="bg-white shadow-sm sticky top-0 z-50">
		<div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
			<a href="/dashboard" class="text-2xl font-bold text-indigo-600">
				<i class="fas fa-graduation-cap mr-2"></i>GoQuizVibe
			</a>
			<div class="flex items-center gap-6">
				<a href="/leaderboard" class="text-gray-600 hover:text-indigo-600 font-medium">
					<i class="fas fa-trophy mr-1"></i>Лидеры
				</a>
				<a href="/errors" class="text-gray-600 hover:text-indigo-600 font-medium">
					<i class="fas fa-book mr-1"></i>Ошибки
				</a>
				<div class="flex items-center gap-3">
					<span class="text-gray-700 font-medium">{ user.Name }</span>
					<a href="/logout" class="px-3 py-1 text-sm text-red-600 hover:text-red-800 font-medium">
						<i class="fas fa-sign-out-alt"></i>
					</a>
				</div>
			</div>
		</div>
	</nav>
}

templ StatsCards(stats *models.UserProgress) {
	<div class="grid md:grid-cols-4 gap-4 mb-8">
		<div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl p-5 text-white">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-orange-100 text-sm">Streak</p>
					<p class="text-3xl font-bold">{ stats.Streak }</p>
				</div>
				<i class="fas fa-fire text-4xl text-orange-300"></i>
			</div>
			<p class="text-orange-100 text-sm mt-2">дней подряд</p>
		</div>

		<div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-5 text-white">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-blue-100 text-sm">Всего XP</p>
					<p class="text-3xl font-bold">{ stats.XP }</p>
				</div>
				<i class="fas fa-star text-4xl text-blue-300"></i>
			</div>
			<p class="text-blue-100 text-sm mt-2">очков опыта</p>
		</div>

		<div class="bg-gradient-to-br from-green-500 to-green-600 rounded-xl p-5 text-white">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-green-100 text-sm">Тестов пройдено</p>
					<p class="text-3xl font-bold">{ len(stats.CompletedQuizzes) }</p>
				</div>
				<i class="fas fa-check-circle text-4xl text-green-300"></i>
			</div>
			<p class="text-green-100 text-sm mt-2">завершено</p>
		</div>

		<div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl p-5 text-white">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-purple-100 text-sm">Ошибок в работе</p>
					<p class="text-3xl font-bold">{ len(stats.WrongAnswers) }</p>
				</div>
				<i class="fas fa-times-circle text-4xl text-purple-300"></i>
			</div>
			<p class="text-purple-100 text-sm mt-2">допущено</p>
		</div>
	</div>
}

templ QuizGrid(quizzes []*models.Quiz) {
	<div class="mb-8">
		<h2 class="text-2xl font-bold mb-4">Доступные тесты</h2>
		if len(quizzes) == 0 {
			<div class="bg-white rounded-xl p-8 text-center text-gray-500">
				<i class="fas fa-inbox text-4xl mb-4"></i>
				<p>Пока нет доступных тестов</p>
			</div>
		} else {
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
				for _, quiz := range quizzes {
					@QuizCard(quiz)
				}
			</div>
		}
	</div>
}

templ QuizCard(quiz *models.Quiz) {
	<a href={ templ.URL("/quiz?id=" + quiz.ID.String()) } class="block bg-white rounded-xl shadow-sm hover:shadow-lg transition-all p-5 border border-gray-100 hover:border-indigo-200">
		<div class="flex justify-between items-start mb-3">
			<span class="px-3 py-1 bg-indigo-100 text-indigo-700 text-sm rounded-full">
				{ quiz.Subject }
			</span>
			<span class="text-gray-400 text-sm">
				{ quiz.Grade } класс
			</span>
		</div>
		<h3 class="text-lg font-semibold mb-2">{ quiz.Title }</h3>
		<p class="text-gray-600 text-sm mb-4">{ quiz.Description }</p>
		<div class="flex justify-between items-center text-sm text-gray-500">
			<span>
				<i class="fas fa-question-circle mr-1"></i>
				{ len(quiz.Questions) } вопросов
			</span>
			<span class="text-indigo-600 font-medium">
				Начать <i class="fas fa-arrow-right ml-1"></i>
			</span>
		</div>
	</a>
}

templ LeaderboardPreview(entries []*models.LeaderboardEntry) {
	<div>
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-2xl font-bold">Таблица лидеров</h2>
			<a href="/leaderboard" class="text-indigo-600 hover:text-indigo-800 font-medium">
				Все <i class="fas fa-arrow-right ml-1"></i>
			</a>
		</div>
		<div class="bg-white rounded-xl shadow-sm p-5">
			if len(entries) == 0 {
				<div class="text-center text-gray-500 py-8">
					<p>Пока нет участников</p>
				</div>
			} else {
				<div class="space-y-3">
					for i, entry := range entries {
						if i >= 5 {
							break
						}
						@LeaderboardRow(entry, i+1)
					}
				</div>
			}
		</div>
	</div>
}

templ LeaderboardRow(entry *models.LeaderboardEntry, position int) {
	<div class="flex items-center gap-4 p-3 rounded-lg hover:bg-gray-50 transition">
		<div class={ PositionClass(position) }>
			{ position }
		</div>
		<div class="flex-1">
			<p class="font-medium">{ entry.UserName }</p>
		</div>
		<div class="text-right">
			<p class="font-bold text-indigo-600">{ entry.XP } XP</p>
			<p class="text-xs text-gray-500">
				<i class="fas fa-fire mr-1"></i>{ entry.Streak }
			</p>
		</div>
	</div>
}
