package pages

import (
	"github.com/goquizvibe/models"
	"github.com/goquizvibe/types"
)

templ DashboardPage(data types.DashboardData) {
	@Base("Панель") {
		@Navbar(data.User)
		<main class="py-8 px-4 mx-auto max-w-6xl">
			@StatsCards(data.Stats)
			@QuizGrid(data.Quizzes)
			@LeaderboardPreview(data.Leaderboard)
		</main>
	}
}

templ Navbar(user *models.User) {
	<nav class="sticky top-0 z-50 bg-white shadow-sm">
		<div class="flex justify-between items-center py-4 px-4 mx-auto max-w-6xl">
			<a href="/dashboard" class="text-2xl font-bold text-indigo-600">
				<i class="mr-2 fas fa-graduation-cap"></i>GoQuizVibe
			</a>
			<div class="flex gap-6 items-center">
				if user.Role == models.RoleTeacher {
					<a href="/admin" class="font-medium text-indigo-600 hover:text-indigo-800">
						<i class="mr-1 fas fa-cog"></i>Админ
					</a>
				}
				<a href="/leaderboard" class="font-medium text-gray-600 hover:text-indigo-600">
					<i class="mr-1 fas fa-trophy"></i>Лидеры
				</a>
				<a href="/errors" class="font-medium text-gray-600 hover:text-indigo-600">
					<i class="mr-1 fas fa-book"></i>Ошибки
				</a>
				<div class="flex gap-3 items-center">
					<span class="font-medium text-gray-700">{ user.Name }</span>
					<a href="/logout" class="py-1 px-3 text-sm font-medium text-red-600 hover:text-red-800">
						<i class="fas fa-sign-out-alt"></i>
					</a>
				</div>
			</div>
		</div>
	</nav>
}

templ StatsCards(stats *models.UserStats) {
	<div class="grid gap-4 mb-8 md:grid-cols-4">
		<div class="p-5 text-white bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl">
			<div class="flex justify-between items-center">
				<div>
					<p class="text-sm text-orange-100">Streak</p>
					<p class="text-3xl font-bold">{ stats.Streak }</p>
				</div>
				<i class="text-4xl text-orange-300 fas fa-fire"></i>
			</div>
			<p class="mt-2 text-sm text-orange-100">дней подряд</p>
		</div>
		<div class="p-5 text-white bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl">
			<div class="flex justify-between items-center">
				<div>
					<p class="text-sm text-blue-100">Всего XP</p>
					<p class="text-3xl font-bold">{ stats.XP }</p>
				</div>
				<i class="text-4xl text-blue-300 fas fa-star"></i>
			</div>
			<p class="mt-2 text-sm text-blue-100">очков опыта</p>
		</div>
		<div class="p-5 text-white bg-gradient-to-br from-green-500 to-green-600 rounded-xl">
			<div class="flex justify-between items-center">
				<div>
					<p class="text-sm text-green-100">Тестов пройдено</p>
					<p class="text-3xl font-bold">{ len(stats.CompletedQuizzes) }</p>
				</div>
				<i class="text-4xl text-green-300 fas fa-check-circle"></i>
			</div>
			<p class="mt-2 text-sm text-green-100">завершено</p>
		</div>
		<div class="p-5 text-white bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl">
			<div class="flex justify-between items-center">
				<div>
					<p class="text-sm text-purple-100">Ошибок в работе</p>
					<p class="text-3xl font-bold">{ stats.WrongCount }</p>
				</div>
				<i class="text-4xl text-purple-300 fas fa-times-circle"></i>
			</div>
			<p class="mt-2 text-sm text-purple-100">допущено</p>
		</div>
	</div>
}

templ QuizGrid(quizzes []*models.Quiz) {
	<div class="mb-8">
		<h2 class="mb-4 text-2xl font-bold">Доступные тесты</h2>
		if len(quizzes) == 0 {
			<div class="p-8 text-center text-gray-500 bg-white rounded-xl">
				<i class="mb-4 text-4xl fas fa-inbox"></i>
				<p>Пока нет доступных тестов</p>
			</div>
		} else {
			<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				for _, quiz := range quizzes {
					@QuizCard(quiz)
				}
			</div>
		}
	</div>
}

templ QuizCard(quiz *models.Quiz) {
	<a href={ templ.URL("/quiz/" + quiz.ID.String() + "/q/0") } class="block p-5 bg-white rounded-xl border border-gray-100 shadow-sm transition-all hover:border-indigo-200 hover:shadow-lg">
		<div class="flex justify-between items-start mb-3">
			<span class="py-1 px-3 text-sm text-indigo-700 bg-indigo-100 rounded-full">
				{ quiz.Subject }
			</span>
			<span class="text-sm text-gray-400">
				{ quiz.Grade } класс
			</span>
		</div>
		<h3 class="mb-2 text-lg font-semibold">{ quiz.Title }</h3>
		<p class="mb-4 text-sm text-gray-600">{ quiz.Description }</p>
		<div class="flex justify-between items-center text-sm text-gray-500">
			<span>
				<i class="mr-1 fas fa-question-circle"></i>
				{ len(quiz.Questions) } вопросов
			</span>
			<span class="font-medium text-indigo-600">
				Начать <i class="ml-1 fas fa-arrow-right"></i>
			</span>
		</div>
	</a>
}

templ LeaderboardPreview(entries []*models.LeaderboardEntry) {
	<div>
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-2xl font-bold">Таблица лидеров</h2>
			<a href="/leaderboard" class="font-medium text-indigo-600 hover:text-indigo-800">
				Все <i class="ml-1 fas fa-arrow-right"></i>
			</a>
		</div>
		<div class="p-5 bg-white rounded-xl shadow-sm">
			if len(entries) == 0 {
				<div class="py-8 text-center text-gray-500">
					<p>Пока нет участников</p>
				</div>
			} else {
				<div class="space-y-3">
					for i, entry := range entries {
						if i >= 5 {
							break
						}
						@LeaderboardRow(entry, i+1)
					}
				</div>
			}
		</div>
	</div>
}

templ LeaderboardRow(entry *models.LeaderboardEntry, position int) {
	<div class="flex gap-4 items-center p-3 rounded-lg transition hover:bg-gray-50">
		<div class={ PositionClass(position) }>
			{ position }
		</div>
		<div class="flex-1">
			<p class="font-medium">{ entry.UserName }</p>
		</div>
		<div class="text-right">
			<p class="font-bold text-indigo-600">{ entry.XP } XP</p>
			<p class="text-xs text-gray-500">
				<i class="mr-1 fas fa-fire"></i>{ entry.Streak }
			</p>
		</div>
	</div>
}
