package pages

import "github.com/goquizvibe/types"

templ LoginPage(err *types.LoginError) {
	@Base("Вход") {
		<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 to-purple-50">
			<div class="w-full max-w-md">
				<div class="text-center mb-8">
					<a href="/" class="text-3xl font-bold text-indigo-600">
						<i class="fas fa-graduation-cap mr-2"></i>GoQuizVibe
					</a>
				</div>

				<div class="bg-white rounded-2xl shadow-xl p-8">
					<h1 class="text-2xl font-bold text-center mb-6">Вход в аккаунт</h1>

					if err != nil {
						<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4">
							{ err.Message }
						</div>
					}

					<form action="/login" method="POST" class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
							<input
								type="email"
								name="email"
								required
								class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
								placeholder="example@mail.ru"
							/>
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Пароль</label>
							<input
								type="password"
								name="password"
								required
								class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
								placeholder="••••••••"
							/>
						</div>

						<button
							type="submit"
							class="w-full py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition"
						>
							Войти
						</button>
					</form>

					<p class="text-center mt-6 text-gray-600">
						Нет аккаунта?
						<a href="/register" class="text-indigo-600 hover:text-indigo-800 font-medium">Зарегистрироваться</a>
					</p>
				</div>
			</div>
		</div>
	}
}
