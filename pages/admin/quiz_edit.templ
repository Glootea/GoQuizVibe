package admin

import (
	"fmt"

	"github.com/goquizvibe/models"
	"github.com/goquizvibe/types"
)

templ QuizEditPage(data types.AdminQuizEditData) {
	@BaseAdmin(fmt.Sprintf("Редактирование: %s", data.Quiz.Title), data.User) {
		<div id="saveAlert" class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg hidden z-50">
			<i class="fas fa-check mr-2"></i>Тест сохранён
		</div>
		<div id="errorAlert" class="fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg hidden z-50">
			<i class="fas fa-times mr-2"></i>Ошибка сохранения
		</div>

		<div class="flex justify-between items-center mb-8">
			<div>
				<a href="/admin/quizzes" class="text-indigo-600 hover:text-indigo-800 text-sm mb-2 inline-block">
					<i class="fas fa-arrow-left mr-1"></i>К списку тестов
				</a>
				<h1 class="text-3xl font-bold">{ data.Quiz.Title }</h1>
			</div>
			<div class="flex gap-3">
				<button type="button" onclick="location.reload()" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
					Отмена
				</button>
				<button type="button" onclick="submitQuizForm()" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition">
					<i class="fas fa-save mr-2"></i>Сохранить всё
				</button>
			</div>
		</div>

		<div class="grid md:grid-cols-3 gap-8">
			<div class="md:col-span-2 space-y-6">
				<div class="bg-white rounded-xl shadow-sm p-6">
					<h2 class="text-xl font-bold mb-4">Информация о тесте</h2>
					<form id="quizEditForm" hx-put={ "/admin/quizzes/" + data.Quiz.ID.String() } hx-trigger="submit" hx-swap="none">
						<input type="hidden" name="intent" value="save_all"/>
						<div class="grid md:grid-cols-2 gap-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Название</label>
								<input type="text" name="title" value={ data.Quiz.Title } required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Предмет</label>
								<input type="text" name="subject" value={ data.Quiz.Subject } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Класс</label>
								<input type="number" name="grade" min="1" max="11" value={ fmt.Sprintf("%d", data.Quiz.Grade) } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Время (мин)</label>
								<input type="number" name="time_limit" min="0" value={ fmt.Sprintf("%d", data.Quiz.TimeLimit) } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
							</div>
							<div class="md:col-span-2">
								<label class="block text-sm font-medium text-gray-700 mb-1">Описание</label>
								<textarea name="description" rows="2" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">{ data.Quiz.Description }</textarea>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Статус</label>
								<select name="status" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
									<option value="available" selected?={ data.Quiz.Status == "available" }>Доступен</option>
									<option value="assigned" selected?={ data.Quiz.Status == "assigned" }>Назначен</option>
									<option value="completed" selected?={ data.Quiz.Status == "completed" }>Завершён</option>
									<option value="archived" selected?={ data.Quiz.Status == "archived" }>Архив</option>
								</select>
							</div>
						</div>
					</form>
				</div>
				@QuestionsSection(data.Quiz, data.Questions)
			</div>
			<div class="space-y-6">
				@QuizStats(data.Questions, data.Quiz.TimeLimit)
				@QuizDangerZone(data.Quiz.ID.String())
			</div>
		</div>

		<script>
			function submitQuizForm() {
				var form = document.getElementById('quizEditForm');
				if (!form) return;
				
				var formData = new FormData(form);
				fetch(form.action || form.getAttribute('hx-put'), {
					method: 'PUT',
					body: formData,
					headers: {
						'HX-Request': 'true'
					}
				}).then(function(response) {
					if (response.ok || response.status === 200) {
						showSaveAlert();
						setTimeout(function() {
							location.reload();
						}, 1000);
					} else {
						showErrorAlert();
					}
				}).catch(function() {
					showErrorAlert();
				});
			}

			function handleQuestionEditSubmit(event) {
				event.preventDefault();
				var button = event.target;
				var quizID = button.getAttribute('data-quiz-id');
				var questionID = button.getAttribute('data-question-id');
				var container = button.closest('div[id^="editForm_"]');
				
				console.log('Submit clicked', { quizID, questionID, container });
				
				if (!container || !quizID || !questionID) {
					console.error('Missing data', { container: !!container, quizID: !!quizID, questionID: !!questionID });
					return;
				}

				var url = '/admin/quizzes/' + quizID + '/question/' + questionID;
				var formData = new FormData();
				
				var inputs = container.querySelectorAll('input, select, textarea');
				inputs.forEach(function(input) {
					if (input.name) {
						formData.append(input.name, input.value);
					}
				});
				
				console.log('Submitting to', url, 'with', Array.from(formData.entries()));
				
				fetch(url, {
					method: 'PUT',
					body: formData,
					headers: {
						'HX-Request': 'true'
					}
				}).then(function(response) {
					console.log('Response status', response.status);
					if (response.ok || response.status === 200) {
						showSaveAlert();
						container.classList.add('hidden');
					} else {
						showErrorAlert();
					}
				}).catch(function(error) {
					console.error('Error:', error);
					showErrorAlert();
				});
			}

			function uploadQuestionImage(input) {
				var url = input.getAttribute('data-upload-url');
				var file = input.files[0];
				if (!file || !url) return;

				var formData = new FormData();
				formData.append('image', file);

				fetch(url, {
					method: 'POST',
					body: formData,
					headers: {
						'HX-Request': 'true'
					}
				}).then(function(response) {
					if (response.ok || response.status === 200) {
						showSaveAlert();
						setTimeout(function() {
							location.reload();
						}, 1000);
					} else {
						showErrorAlert();
					}
				}).catch(function() {
					showErrorAlert();
				});
			}

			function deleteQuestionImage(button) {
				var url = button.getAttribute('data-delete-url');
				if (!url) return;
				if (!confirm('Удалить изображение?')) return;

				fetch(url, {
					method: 'DELETE',
					headers: {
						'HX-Request': 'true'
					}
				}).then(function(response) {
					if (response.ok || response.status === 200) {
						var container = button.closest('.relative.group');
						if (container) {
							container.remove();
						}
					} else {
						showErrorAlert();
					}
				}).catch(function() {
					showErrorAlert();
				});
			}

			var isDirty = false;
			var initialData = {};

			function markDirty() {
				isDirty = true;
			}

			function setupDirtyTracking() {
				var form = document.getElementById('quizEditForm');
				if (!form) return;

				initialData = getFormData(form);

				var inputs = form.querySelectorAll('input, select, textarea');
				inputs.forEach(function(input) {
					input.addEventListener('change', markDirty);
					input.addEventListener('input', markDirty);
				});
			}

			function getFormData(form) {
				var data = {};
				var inputs = form.querySelectorAll('input, select, textarea');
				inputs.forEach(function(input) {
					if (input.name) {
						data[input.name] = input.value;
					}
				});
				return data;
			}

			window.addEventListener('beforeunload', function(e) {
				if (isDirty) {
					e.preventDefault();
					e.returnValue = '';
				}
			});

			function showSaveAlert() {
				var alert = document.getElementById('saveAlert');
				alert.classList.remove('hidden');
				setTimeout(function() {
					alert.classList.add('hidden');
				}, 2000);
			}

			function showErrorAlert() {
				var alert = document.getElementById('errorAlert');
				alert.classList.remove('hidden');
				setTimeout(function() {
					alert.classList.add('hidden');
				}, 2000);
			}

			function toggleEditForm(quizId, index) {
				var formId = 'editForm_' + quizId + '_' + index;
				var form = document.getElementById(formId);
				if (form) {
					form.classList.toggle('hidden');
				}
			}

			function updateAnswerOptions(select) {
				var container = select.closest('.space-y-3').querySelector('.answer-options-container');
				if (!container) return;

				if (select.value === 'choice') {
					container.innerHTML = `
						<label class="block text-sm font-medium text-gray-700 mb-1">Варианты ответов</label>
						<div class="options-list space-y-2">
							<div class="flex items-center gap-2 option-row">
								<input type="radio" name="correct_answer" value="option_0" class="w-4 h-4 text-indigo-600"/>
								<input type="text" name="option_0" placeholder="Вариант 1" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
								<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
							</div>
							<div class="flex items-center gap-2 option-row">
								<input type="radio" name="correct_answer" value="option_1" class="w-4 h-4 text-indigo-600"/>
								<input type="text" name="option_1" placeholder="Вариант 2" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
								<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
							</div>
						</div>
						<button type="button" onclick="addOption(this)" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">
							<i class="fas fa-plus mr-1"></i>Добавить вариант
						</button>
					`;
				} else {
					container.innerHTML = `
						<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
						<input type="text" name="correct_answer" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					`;
				}
			}

			function updateAddFormAnswerOptions(select) {
				var container = select.closest('div[hx-post]').querySelector('#addFormAnswerOptions');
				if (!container) return;

				if (select.value === 'choice') {
					container.innerHTML = `
						<label class="block text-sm font-medium text-gray-700 mb-1">Варианты ответов</label>
						<div id="addFormOptionsList" class="space-y-2">
							<div class="flex items-center gap-2 option-row">
								<input type="radio" name="correct_answer" value="option_0" class="w-4 h-4 text-indigo-600"/>
								<input type="text" name="option_0" placeholder="Вариант 1" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
								<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
							</div>
							<div class="flex items-center gap-2 option-row">
								<input type="radio" name="correct_answer" value="option_1" class="w-4 h-4 text-indigo-600"/>
								<input type="text" name="option_1" placeholder="Вариант 2" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
								<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
							</div>
						</div>
						<button type="button" onclick="addOptionToForm()" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">
							<i class="fas fa-plus mr-1"></i>Добавить вариант
						</button>
					`;
				} else {
					container.innerHTML = `
						<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
						<input type="text" name="correct_answer" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					`;
				}
			}

			function addOption(button) {
				var container = button.closest('.answer-options-container');
				var optionsList = container.querySelector('.options-list');
				if (!optionsList) return;
				var count = optionsList.querySelectorAll('.option-row').length;
				var newRow = document.createElement('div');
				newRow.className = 'flex items-center gap-2 option-row';
				newRow.innerHTML = `
					<input type="radio" name="correct_answer" value="option_${count}" class="w-4 h-4 text-indigo-600"/>
					<input type="text" name="option_${count}" placeholder="Вариант ${count + 1}" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
				`;
				optionsList.appendChild(newRow);
			}

			function addOptionToForm() {
				var optionsList = document.getElementById('addFormOptionsList');
				if (!optionsList) return;
				var count = optionsList.querySelectorAll('.option-row').length;
				var newRow = document.createElement('div');
				newRow.className = 'flex items-center gap-2 option-row';
				newRow.innerHTML = `
					<input type="radio" name="correct_answer" value="option_${count}" class="w-4 h-4 text-indigo-600"/>
					<input type="text" name="option_${count}" placeholder="Вариант ${count + 1}" class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
				`;
				optionsList.appendChild(newRow);
			}

			function removeOption(btn) {
				var row = btn.closest('.option-row');
				if (row && row.parentElement.querySelectorAll('.option-row').length > 2) {
					row.remove();
				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				setupDirtyTracking();
			});
		</script>
	}
}

templ QuestionsSection(quiz *models.Quiz, questions []models.Question) {
	<div id="questions-section" class="bg-white rounded-xl shadow-sm p-6">
		<h2 class="text-xl font-bold mb-4">Вопросы ({ len(questions) })</h2>

		if len(questions) == 0 {
			<div class="text-center py-8 text-gray-500">
				<i class="fas fa-question-circle text-4xl mb-4 text-gray-300"></i>
				<p>Пока нет вопросов</p>
			</div>
		} else {
			<div id="questions-list" class="space-y-4">
				for i, q := range questions {
					@QuestionCard(q, i, quiz.ID.String())
				}
			</div>
		}

		@AddQuestionButton()
		@AddQuestionForm(quiz.ID.String(), len(questions))
	</div>
}

templ QuestionCard(q models.Question, index int, quizID string) {
	<div id={ "question-card-" + q.ID.String() } class="border rounded-lg p-4">
		<div class="flex justify-between items-start mb-2">
			<div class="flex items-center gap-2">
				<span class="bg-gray-200 text-gray-700 px-2 py-1 rounded text-sm font-medium">{ index + 1 }</span>
				<span class="px-2 py-1 bg-indigo-100 text-indigo-700 rounded text-sm">{ q.Type }</span>
				<span class="text-gray-500 text-sm">{ q.Points } баллов</span>
			</div>
			<div hx-delete={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() }
				hx-target={ "#question-card-" + q.ID.String() }
				hx-swap="delete"
				hx-confirm="Удалить вопрос?"
				class="inline"
			>
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				<button type="button" class="text-red-600 hover:text-red-800 text-sm ml-2">
					<i class="fas fa-trash"></i>
				</button>
			</div>
		</div>
		<p class="text-gray-800 mb-2">{ q.Text }</p>
		@QuestionImagesSection(q, quizID)
		if q.Type == models.QuestionTypeChoice && len(models.GetQuestionOptions(q)) > 0 {
			<div class="text-sm text-gray-600">
				<p class="font-medium">Варианты:</p>
				for _, opt := range models.GetQuestionOptions(q) {
					<span class="inline-block bg-gray-100 px-2 py-1 rounded mr-1 mt-1">{ opt }</span>
				}
			</div>
		}
		<div class="mt-2 text-sm">
			<p class="text-green-600"><i class="fas fa-check mr-1"></i>Ответ: { q.CorrectAnswer }</p>
			if q.Explanation != "" {
				<p class="text-gray-500 mt-1"><i class="fas fa-info-circle mr-1"></i>{ q.Explanation }</p>
			}
		</div>

		<div id={ "editForm_" + quizID + "_" + fmt.Sprintf("%d", index) } class="hidden mt-4 pt-4 border-t">
			<div>
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				@QuestionEditFields(q)
			</div>
			<div class="flex justify-end gap-2 mt-4">
				<button
					type="button"
					data-quiz-id={ quizID }
					data-question-id={ q.ID.String() }
					onclick="handleQuestionEditSubmit(event)"
					class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded transition"
				>Сохранить</button>
			</div>
		</div>
		<div class="mt-3 pt-3 border-t flex gap-2">
			<button
				type="button"
				data-quiz-id={ quizID }
				data-index={ fmt.Sprintf("%d", index) }
				data-qid={ q.ID.String() }
				onclick="toggleEditForm(this.dataset.quizId, this.dataset.index)"
				class="text-sm text-indigo-600 hover:text-indigo-800"
			>
				<i class="fas fa-edit mr-1"></i>Редактировать
			</button>
		</div>
	</div>
}

templ QuestionEditFields(q models.Question) {
	<div class="space-y-3">
		<div>
			<label class="block text-sm font-medium text-gray-700 mb-1">Текст вопроса</label>
			<input type="text" name="text" value={ q.Text } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Тип</label>
				<select
					name="type"
					class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"
					onchange="updateAnswerOptions(this)"
					id="typeSelect"
				>
					<option value="choice" selected?={ q.Type == "choice" }>Выбор</option>
					<option value="open" selected?={ q.Type == "open" }>Открытый</option>
					<option value="fill" selected?={ q.Type == "fill" }>Заполнить</option>
				</select>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Баллы</label>
				<input type="number" name="points" min="1" value={ fmt.Sprintf("%d", q.Points) } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
			</div>
		</div>
		<div class="answer-options-container">
			@AnswerOptionsByType(q)
		</div>
		<div>
			<label class="block text-sm font-medium text-gray-700 mb-1">Пояснение</label>
			<input type="text" name="explanation" value={ q.Explanation } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
		</div>
	</div>
}

templ AnswerOptionsByType(q models.Question) {
	switch q.Type {
		case models.QuestionTypeOpen:
			<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
			<input type="text" name="correct_answer" value={ q.CorrectAnswer } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
		case models.QuestionTypeFill:
			<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
			<input type="text" name="correct_answer" value={ q.CorrectAnswer } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
		case models.QuestionTypeChoice:
			<label class="block text-sm font-medium text-gray-700 mb-1">Варианты ответов</label>
			<div class="options-list space-y-2">
				for i, opt := range models.GetQuestionOptions(q) {
					<div class="flex items-center gap-2 option-row">
						<input type="radio" name="correct_answer" value={ fmt.Sprintf("option_%d", i) } checked?={ opt == q.CorrectAnswer } class="w-4 h-4 text-indigo-600"/>
						<input type="text" name={ "option_" + fmt.Sprintf("%d", i) } value={ opt } class="flex-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
						<button type="button" onclick="removeOption(this)" class="text-red-500 hover:text-red-700">
							<i class="fas fa-times"></i>
						</button>
					</div>
				}
			</div>
			<button type="button" onclick="addOption(this)" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">
				<i class="fas fa-plus mr-1"></i>Добавить вариант
			</button>
	}
}

templ AnswerOptionsEmpty() {
	<div id="answerTypeContainer">
		<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
		<input type="text" name="correct_answer" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
	</div>
}

templ AddQuestionButton() {
	<button onclick="document.getElementById('addQuestionFormWrapper').classList.toggle('hidden')" class="mt-4 w-full py-3 border-2 border-dashed border-gray-300 rounded-lg text-gray-500 hover:border-indigo-400 hover:text-indigo-600 transition">
		<i class="fas fa-plus mr-2"></i>Добавить вопрос
	</button>
}

templ AddQuestionForm(quizID string, questionCount int) {
	<div id="addQuestionFormWrapper" class="hidden mt-4 pt-4 border-t">
		<div hx-post={ "/admin/quizzes/" + quizID + "/question" }
			hx-target="#questions-section"
			hx-swap="innerHTML"
			enctype="multipart/form-data"
		>
			<h3 class="font-semibold mb-3">Новый вопрос</h3>
			<div class="space-y-3">
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Текст вопроса</label>
					<input type="text" name="text" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div class="grid grid-cols-3 gap-3">
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Тип</label>
						<select name="type" id="addFormTypeSelect" onchange="updateAddFormAnswerOptions(this)" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
							<option value="choice">Выбор</option>
							<option value="open">Открытый</option>
							<option value="fill">Заполнить</option>
						</select>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Баллы</label>
						<input type="number" name="points" min="1" value="10" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">№</label>
						<input type="number" name="order_index" min="0" value={ fmt.Sprintf("%d", questionCount) } class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
					</div>
				</div>
				<div id="addFormAnswerOptions">
					<label class="block text-sm font-medium text-gray-700 mb-1">Правильный ответ</label>
					<input type="text" name="correct_answer" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Пояснение</label>
					<input type="text" name="explanation" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Изображения (до 3)</label>
					<input type="file" name="images" multiple accept=".jpg,.jpeg,.png,.webp" class="text-sm text-gray-500"/>
					<p class="text-xs text-gray-500 mt-1">JPG, PNG, WebP до 5MB каждое</p>
				</div>
			</div>
			<div class="flex justify-end gap-2 mt-4">
				<button type="button" onclick="document.getElementById('addQuestionFormWrapper').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800">
					Отмена
				</button>
				<button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition">
					<i class="fas fa-plus mr-2"></i>Добавить
				</button>
			</div>
		</div>
	</div>
}

templ QuizStats(questions []models.Question, timeLimit int) {
	<div class="bg-white rounded-xl shadow-sm p-6">
		<h3 class="font-bold mb-4">Статистика</h3>
		<div class="space-y-3">
			<div class="flex justify-between">
				<span class="text-gray-600">Вопросов</span>
				<span class="font-semibold">{ len(questions) }</span>
			</div>
			<div class="flex justify-between">
				<span class="text-gray-600">Всего баллов</span>
				<span class="font-semibold">{ getTotalPoints(questions) }</span>
			</div>
			<div class="flex justify-between">
				<span class="text-gray-600">Время</span>
				<span class="font-semibold">{ timeLimit } мин</span>
			</div>
		</div>
	</div>
}

templ QuizDangerZone(quizID string) {
	<div class="bg-white rounded-xl shadow-sm p-6">
		<h3 class="font-bold mb-4">Опасная зона</h3>
		<div hx-delete={ "/admin/quizzes/" + quizID }
			hx-confirm="Вы уверены? Это действие обратимо."
			class="inline"
		>
			<button type="button" class="w-full px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition">
				<i class="fas fa-archive mr-2"></i>Перенести в архив
			</button>
		</div>
	</div>
}

func getTotalPoints(questions []models.Question) int {
	total := 0
	for _, q := range questions {
		total += q.Points
	}
	return total
}

templ QuestionImagesSection(q models.Question, quizID string) {
	<div class="mb-3">
		<div class="flex items-center justify-between mb-2">
			<span class="text-sm font-medium text-gray-700">Изображения ({ len(q.Images) }/3)</span>
		</div>
		if len(q.Images) > 0 {
			<div class="flex flex-wrap gap-2 mb-2">
				for _, img := range q.Images {
					<div class="relative group">
						<img src={ img.URL } class="w-24 h-24 object-cover rounded-lg border"/>
						<button
							type="button"
							class="absolute -top-2 -right-2 w-6 h-6 bg-red-500 text-white rounded-full text-xs opacity-0 group-hover:opacity-100 transition"
							data-delete-url={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() + "/image/" + img.ID.String() }
							onclick="deleteQuestionImage(this)"
						>
							<i class="fas fa-times"></i>
						</button>
					</div>
				}
			</div>
		}
		if len(q.Images) < 3 {
			<div class="flex items-center gap-2">
				<input type="hidden" name="question_id" value={ q.ID.String() }/>
				<input
					type="file"
					name="image"
					accept=".jpg,.jpeg,.png,.webp"
					class="text-sm text-gray-500"
					data-upload-url={ "/admin/quizzes/" + quizID + "/question/" + q.ID.String() + "/image" }
					onchange="uploadQuestionImage(this)"
				/>
				<button type="button" class="px-3 py-1 bg-indigo-100 hover:bg-indigo-200 text-indigo-700 rounded text-sm transition">
					<i class="fas fa-upload mr-1"></i>Загрузить
				</button>
			</div>
		}
	</div>
}