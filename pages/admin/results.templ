package admin

import (
	"fmt"

	"github.com/goquizvibe/locales"
	"github.com/goquizvibe/types"
)

templ ResultsPage(data types.AdminResultsData, t locales.Translator) {
	@BaseAdmin(t.QuizResults(), data.User, t) {
		<h1 class="mb-8 text-3xl font-bold">{ t.QuizResults() }</h1>
		<div class="p-6 mb-8 bg-white rounded-xl shadow-sm">
			<div class="flex gap-4 items-center">
				<div class="flex-1">
					<h2 class="mb-2 font-semibold">{ t.FilterByQuiz() }</h2>
					<select id="quizFilter" onchange="filterResults()" class="py-2 px-3 w-full rounded-lg border focus:ring-2 focus:ring-indigo-500">
						<option value="">{ t.AllQuizzes() }</option>
						for _, quiz := range data.Quizzes {
							<option value={ quiz.ID.String() }>{ quiz.Title }</option>
						}
					</select>
				</div>
				<div class="text-right">
					<p class="text-sm text-gray-500">{ t.TotalAttempts() }</p>
					<p class="text-2xl font-bold text-indigo-600">{ len(data.Attempts) }</p>
				</div>
			</div>
		</div>
		if len(data.Attempts) == 0 {
			<div class="p-12 text-center bg-white rounded-xl shadow-sm">
				<i class="mb-4 text-6xl text-gray-300 fas fa-clipboard-list"></i>
				<p class="text-lg text-gray-500">{ t.NoResultsYet() }</p>
				<p class="mt-2 text-sm text-gray-400">{ t.ResultsWillAppearAfterStudentsCompleteQuizzes() }</p>
			</div>
		} else {
			<div class="overflow-hidden bg-white rounded-xl shadow-sm">
				<table class="w-full">
					<thead class="bg-gray-50 border-b">
						<tr>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Student() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Quiz() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">{ t.Date() }</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">Баллы</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">%</th>
							<th class="py-4 px-6 font-semibold text-left text-gray-600">Статус</th>
						</tr>
					</thead>
					<tbody id="resultsTableBody" class="divide-y">
						for _, attempt := range data.Attempts {
							<tr class="hover:bg-gray-50 result-row" data-quiz-id={ attempt.QuizID.String() }>
								<td class="py-4 px-6">
									<div class="flex gap-3 items-center">
										<i class="text-gray-400 fas fa-user-graduate"></i>
										<span class="font-medium">{ attempt.UserName }</span>
									</div>
								</td>
								<td class="py-4 px-6 text-gray-600">{ attempt.QuizTitle }</td>
								<td class="py-4 px-6 text-sm text-gray-500">
									if !attempt.CompletedAt.IsZero() {
										{ attempt.CompletedAt.Format("2006-01-02 15:04") }
									}
								</td>
								<td class="py-4 px-6 font-semibold">
									{ attempt.Score }/{ attempt.MaxScore }
								</td>
								<td class="py-4 px-6">
									{ getPercentage(attempt.Score, attempt.MaxScore) }
								</td>
								<td class="py-4 px-6">
									<span class={ "px-2 py-1 rounded text-sm " + getResultStatusClass(attempt.Score, attempt.MaxScore) }>
										{ getResultStatus(attempt.Score, attempt.MaxScore, t) }
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func getPercentage(score, maxScore int) string {
	if maxScore == 0 {
		return "0%"
	}
	return fmt.Sprintf("%.0f%%", float64(score)/float64(maxScore)*100)
}

func getResultStatusClass(score, maxScore int) string {
	if maxScore == 0 {
		return "bg-gray-100 text-gray-700"
	}
	percentage := float64(score) / float64(maxScore) * 100
	if percentage >= 80 {
		return "bg-green-100 text-green-700"
	} else if percentage >= 60 {
		return "bg-yellow-100 text-yellow-700"
	}
	return "bg-red-100 text-red-700"
}

func getResultStatus(score, maxScore int, t locales.Translator) string {
	if maxScore == 0 {
		return "Ошибка"
	}
	percentage := float64(score) / float64(maxScore) * 100
	if percentage >= 80 {
		return t.Excellent()
	} else if percentage >= 60 {
		return t.Good()
	} else if percentage >= 40 {
		return t.Satisfactory()
	}
	return t.Unsatisfactory()
}
