package admin

import (
	"fmt"

	"github.com/goquizvibe/types"
)

templ StatisticsPage(data *types.AdminStatisticsData) {
	@BaseAdmin("Статистика", data.User) {
		<h1 class="text-3xl font-bold mb-8">Сводная статистика</h1>

		<div class="grid md:grid-cols-4 gap-6 mb-8">
			<div class="bg-white rounded-xl shadow-sm p-6">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-gray-500 text-sm">Тестов</p>
						<p class="text-3xl font-bold text-indigo-600">{ data.TotalQuizzes }</p>
					</div>
					<i class="fas fa-file-alt text-3xl text-indigo-200"></i>
				</div>
			</div>
			<div class="bg-white rounded-xl shadow-sm p-6">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-gray-500 text-sm">Учеников</p>
						<p class="text-3xl font-bold text-green-600">{ data.TotalStudents }</p>
					</div>
					<i class="fas fa-users text-3xl text-green-200"></i>
				</div>
			</div>
			<div class="bg-white rounded-xl shadow-sm p-6">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-gray-500 text-sm">Прохождений</p>
						<p class="text-3xl font-bold text-orange-600">{ data.TotalAttempts }</p>
					</div>
					<i class="fas fa-play-circle text-3xl text-orange-200"></i>
				</div>
			</div>
			<div class="bg-white rounded-xl shadow-sm p-6">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-gray-500 text-sm">Средний балл</p>
						<p class="text-3xl font-bold text-purple-600">{ fmt.Sprintf("%.1f", data.AvgScore) }%</p>
					</div>
					<i class="fas fa-chart-line text-3xl text-purple-200"></i>
				</div>
			</div>
		</div>

		<div class="grid md:grid-cols-2 gap-8 mb-8">
			<div class="bg-white rounded-xl shadow-sm p-6">
				<h2 class="text-xl font-bold mb-4">Статистика по тестам</h2>
				if len(data.QuizStats) == 0 {
					<div class="text-center py-8 text-gray-500">
						<p>Пока нет данных</p>
					</div>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b">
									<th class="text-left py-2 text-gray-600">Тест</th>
									<th class="text-right py-2 text-gray-600">Прохождений</th>
									<th class="text-right py-2 text-gray-600">Ср. балл</th>
									<th class="text-right py-2 text-gray-600">Успешность</th>
								</tr>
							</thead>
							<tbody>
								for _, stat := range data.QuizStats {
									<tr class="border-b">
										<td class="py-3">
											<p class="font-medium">{ stat.Quiz.Title }</p>
											<p class="text-xs text-gray-500">{ stat.Quiz.Subject }</p>
										</td>
										<td class="py-3 text-right">{ stat.AttemptCount }</td>
										<td class="py-3 text-right">
											<span class={ getScoreColorClass(stat.AvgScore) }>{ fmt.Sprintf("%.1f%%", stat.AvgScore) }</span>
										</td>
										<td class="py-3 text-right">
											<div class="flex items-center justify-end gap-2">
												<div class="w-16 bg-gray-200 rounded-full h-2">
													<div class={ "h-2 rounded-full " + getPassRateColorClass(stat.PassRate) } style={ fmt.Sprintf("width: %.0f%%", stat.PassRate) }></div>
												</div>
												<span class="text-xs">{ fmt.Sprintf("%.0f%%", stat.PassRate) }</span>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="bg-white rounded-xl shadow-sm p-6">
				<h2 class="text-xl font-bold mb-4">Распределение по предметам</h2>
				if len(data.SubjectDistribution) == 0 {
					<div class="text-center py-8 text-gray-500">
						<p>Пока нет данных</p>
					</div>
				} else {
					<div class="space-y-4">
						for subject, count := range data.SubjectDistribution {
							<div>
								<div class="flex justify-between text-sm mb-1">
									<span class="font-medium">{ subject }</span>
									<span class="text-gray-500">{ count } тест(ов)</span>
								</div>
								<div class="w-full bg-gray-200 rounded-full h-3">
									<div class="bg-indigo-500 h-3 rounded-full" style={ fmt.Sprintf("width: %d%%", count*10) }></div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>

		<div class="bg-white rounded-xl shadow-sm p-6">
			<h2 class="text-xl font-bold mb-4">Распределение учеников по классам</h2>
			if len(data.GradeDistribution) == 0 {
				<div class="text-center py-8 text-gray-500">
					<p>Пока нет данных</p>
				</div>
			} else {
				<div class="flex items-end justify-around gap-2 h-48">
					for grade := 1; grade <= 11; grade++ {
						<div class="flex flex-col items-center">
							<div class="w-8 bg-indigo-500 rounded-t" style={ fmt.Sprintf("height: %dpx", getBarHeight(data.GradeDistribution[grade], data.GradeDistribution)) }></div>
							<span class="text-xs text-gray-500 mt-1">{ grade }</span>
						</div>
					}
				</div>
			}
		</div>
	}
}

func getScoreColorClass(score float64) string {
	if score >= 80 {
		return "text-green-600 font-semibold"
	} else if score >= 60 {
		return "text-yellow-600 font-semibold"
	}
	return "text-red-600 font-semibold"
}

func getPassRateColorClass(rate float64) string {
	if rate >= 80 {
		return "bg-green-500"
	} else if rate >= 60 {
		return "bg-yellow-500"
	}
	return "bg-red-500"
}

func getBarHeight(count int, dist map[int]int) int {
	max := 0
	for _, v := range dist {
		if v > max {
			max = v
		}
	}
	if max == 0 {
		return 10
	}
	return (count * 100) / max
}