package admin

import (
	"github.com/goquizvibe/db"
	"github.com/goquizvibe/locales"
)

templ LearningMaterialsPreviewPage(user *db.User, material *db.LearningMaterial, url string, t locales.Translator) {
	@BaseAdmin(t.SvgPreview()+" - "+material.Title, user, t) {
		<div class="min-h-screen bg-gray-100 p-8">
			<div class="max-w-6xl mx-auto">
				<div class="bg-white rounded-xl shadow-sm p-6 mb-6">
					<div class="flex items-center justify-between">
						<div>
							<h1 class="text-2xl font-bold">{ material.Title }</h1>
							<p class="text-gray-500">{ t.SvgPreview() }</p>
						</div>
						<a
							href={ "/admin/learning-materials/" + templ.URL(material.ID.String()) }
							class="py-2 px-4 text-indigo-600 border border-indigo-600 rounded-lg hover:bg-indigo-50 transition"
						>
							<i class="mr-1 fas fa-arrow-left"></i>{ t.BackToEdit() }
						</a>
					</div>
				</div>
				<div class="bg-white rounded-xl shadow-sm p-8 flex items-center justify-center">
					if url != "" {
						<img
							src={ templ.URL(url) }
							alt={ t.SvgPreview() }
							class="max-w-full"
						/>
					} else {
						<div class="text-center text-gray-500">
							<i class="mb-4 text-6xl text-gray-300 fas fa-file-code"></i>
							<p>{ t.PreviewNotAvailable() }</p>
						</div>
					}
				</div>
			</div>
		</div>
	}
}