package pages

import "github.com/goquizvibe/locales"

templ LandingPage(t locales.Translator) {
	@Base("GoQuizVibe", t) {
		<nav class="sticky top-0 z-50 bg-white shadow-sm">
			<div class="flex justify-between items-center py-4 px-4 mx-auto max-w-6xl">
				<a href="/" class="text-2xl font-bold text-indigo-600">
					<i class="mr-2 fas fa-graduation-cap"></i>GoQuizVibe
				</a>
				<div class="flex gap-4">
					<a href="/login" class="py-2 px-4 font-medium text-indigo-600 hover:text-indigo-800">{ t.SignIn() }</a>
					<a href="/register" class="py-2 px-4 font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">{ t.SignUp() }</a>
				</div>
			</div>
		</nav>
		<main>
			<section class="py-20 bg-gradient-to-br from-indigo-50 to-purple-50">
				<div class="px-4 mx-auto max-w-6xl text-center">
					<h1 class="mb-6 text-5xl font-bold text-gray-900">
						{ t.LearnThroughPlay() }
					</h1>
					<p class="mx-auto mb-8 max-w-2xl text-xl text-gray-600">
						{ t.InteractiveExamPreparationPlatformWithGamificationEarnXpMaintainStreaksAndCompeteWithFriends() }
					</p>
					<div class="flex gap-4 justify-center">
						<a href="/register" class="py-3 px-8 text-lg font-semibold text-white bg-indigo-600 rounded-xl shadow-lg transition-all hover:bg-indigo-700 hover:shadow-xl">
							{ t.StartFree() }
						</a>
						<a href="/login" class="py-3 px-8 text-lg font-semibold text-indigo-600 bg-white rounded-xl border-2 border-indigo-600 transition-all hover:bg-indigo-50">
							{ t.LogIn() }
						</a>
					</div>
				</div>
			</section>
			<section class="py-16 bg-white">
				<div class="px-4 mx-auto max-w-6xl">
					<h2 class="mb-12 text-3xl font-bold text-center">{ t.WhyGoquizvibe() }</h2>
					<div class="grid gap-8 md:grid-cols-3">
						<div class="p-6 bg-gradient-to-br from-orange-50 to-yellow-50 rounded-xl border border-orange-100">
							<div class="flex justify-center items-center mb-4 w-12 h-12 bg-orange-500 rounded-lg">
								<i class="text-xl text-white fas fa-fire"></i>
							</div>
							<h3 class="mb-2 text-xl font-semibold">{ t.DayStreak() }</h3>
							<p class="text-gray-600">{ t.PracticeDailyToKeepYourStreakConsistencyIsTheKeyToSuccess() }</p>
						</div>
						<div class="p-6 bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl border border-green-100">
							<div class="flex justify-center items-center mb-4 w-12 h-12 bg-green-500 rounded-lg">
								<i class="text-xl text-white fas fa-trophy"></i>
							</div>
							<h3 class="mb-2 text-xl font-semibold">{ t.Leaderboard() }</h3>
							<p class="text-gray-600">{ t.CompeteWithClassmatesWeeklyRatingsAndBonusRewards() }</p>
						</div>
						<div class="p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border border-blue-100">
							<div class="flex justify-center items-center mb-4 w-12 h-12 bg-blue-500 rounded-lg">
								<i class="text-xl text-white fas fa-bolt"></i>
							</div>
							<h3 class="mb-2 text-xl font-semibold">{ t.Explanation() }</h3>
							<p class="text-gray-600">{ t.SeeCorrectAnswersImmediatelyAfterEachQuestionLearnFromYourMistakes() }</p>
						</div>
					</div>
				</div>
			</section>
			<section class="py-16 bg-gray-50">
				<div class="px-4 mx-auto max-w-6xl">
					<h2 class="mb-12 text-3xl font-bold text-center">{ t.Subjects() }</h2>
					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						<div class="p-6 bg-white rounded-xl shadow-sm transition-shadow hover:shadow-md">
							<i class="mb-4 text-4xl text-indigo-600 fas fa-calculator"></i>
							<h3 class="text-xl font-semibold">Math</h3>
							<p class="mt-2 text-gray-600">{ t.MathFromBasicArithmeticToAlgebra() }</p>
						</div>
						<div class="p-6 bg-white rounded-xl shadow-sm transition-shadow hover:shadow-md">
							<i class="mb-4 text-4xl text-purple-600 fas fa-atom"></i>
							<h3 class="text-xl font-semibold">Physics</h3>
							<p class="mt-2 text-gray-600">{ t.PhysicsMechanicsElectricityOptics() }</p>
						</div>
						<div class="p-6 bg-white rounded-xl shadow-sm transition-shadow hover:shadow-md">
							<i class="mb-4 text-4xl text-green-600 fas fa-flask"></i>
							<h3 class="text-xl font-semibold">Chemistry</h3>
							<p class="mt-2 text-gray-600">{ t.ChemistryOrganicAndInorganic() }</p>
						</div>
					</div>
				</div>
			</section>
			<section class="py-16 text-white bg-indigo-600">
				<div class="px-4 mx-auto max-w-4xl text-center">
					<h2 class="mb-4 text-3xl font-bold">{ t.ReadyToStart() }</h2>
					<p class="mb-8 text-xl text-indigo-100">{ t.JoinThousandsOfStudentsWhoAreAlreadyLearningWithJoy() }</p>
					<a href="/register" class="py-3 px-8 text-lg font-semibold text-indigo-600 bg-white rounded-xl hover:bg-gray-100">
						{ t.SignUpFree() }
					</a>
				</div>
			</section>
		</main>
		<footer class="py-8 text-gray-400 bg-gray-900">
			<div class="px-4 mx-auto max-w-6xl text-center">
				<p>&copy; 2026 GoQuizVibe. All rights reserved.</p>
			</div>
		</footer>
	}
}
