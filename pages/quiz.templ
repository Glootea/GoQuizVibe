package pages

import (
	"fmt"

	"github.com/goquizvibe/models"
	"github.com/goquizvibe/types"
)

func plural(count int, one, few, many string) string {
	if count%10 == 1 && count%100 != 11 {
		return one
	}
	if count%10 >= 2 && count%10 <= 4 && (count%100 < 10 || count%100 >= 20) {
		return few
	}
	return many
}

templ QuizPage(data types.QuizPageData) {
	@Base("Тест") {
		<div class="min-h-screen bg-gradient-to-br from-indigo-50 to-purple-50">
			<div class="max-w-2xl mx-auto px-4 py-8">
				<div class="flex justify-between items-center mb-6">
					<a href="/dashboard" class="text-gray-600 hover:text-gray-900">
						<i class="fas fa-arrow-left mr-2"></i>Назад
					</a>
					<div class="text-right">
						<p class="font-bold text-lg">{ data.Quiz.Title }</p>
						<p class="text-sm text-gray-500">{ len(data.Quiz.Questions) } вопросов</p>
					</div>
				</div>

				<div id="quiz-container" hx-ext="json-enc">
					<div class="bg-white rounded-2xl shadow-xl p-8">
						<div id="question-content">
							<div class="mb-6">
								<span id="question-counter" class="text-sm text-indigo-600 font-medium">Вопрос 1 из { len(data.Quiz.Questions) }</span>
							</div>

							<form
								id="quiz-form"
								hx-post={ "/quiz/" + data.Quiz.ID.String() + "/submit?session=" + data.SessionID }
								hx-target="#question-content"
								hx-swap="innerHTML"
							>
								<input type="hidden" name="question_index" id="question-index" value="0"/>

								<div id="question-text" class="text-xl font-medium mb-6">
									{ data.Quiz.Questions[0].Text }
								</div>

								if data.Quiz.Questions[0].Type == models.QuestionTypeChoice {
									<div id="options-container" class="space-y-3">
										for _, option := range data.Quiz.Questions[0].GetOptions() {
											<label class="block p-4 border border-gray-200 rounded-xl cursor-pointer hover:bg-indigo-50 hover:border-indigo-300 transition">
												<input
													type="radio"
													name="answer"
													value={ option }
													class="mr-3"
													required
												/>
												{ option }
											</label>
										}
									</div>
								} else {
									<input
										type="text"
										name="answer"
										id="answer-input"
										class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"
										placeholder="Введите ответ..."
										required
									/>
								}

								<button
									type="submit"
									class="w-full mt-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition"
								>
									Ответить
								</button>
							</form>
						</div>

						<div id="feedback-container" class="hidden mt-6 p-4 rounded-xl"></div>
					</div>
				</div>
			</div>
		</div>
	}
}

templ QuestionFeedback(answer string, isCorrect bool, explanation string) {
	<div class="p-4 rounded-xl bg-green-50 border border-green-200">
		<div class="flex items-center gap-2 mb-2">
			<i class="fas fa-check-circle text-green-600"></i>
			<span class="font-semibold text-green-700">Правильно!</span>
		</div>
		if explanation != "" {
			<p class="text-sm text-gray-600">{ explanation }</p>
		}
	</div>
}

templ QuizResultPage(data types.QuizResultData) {
	@Base("Результат") {
		@Navbar(data.User)

		<main class="max-w-3xl mx-auto px-4 py-8">
			<div class="text-center mb-8">
				<div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
					<i class="fas fa-check text-4xl text-white"></i>
				</div>
				<h1 class="text-3xl font-bold mb-2">Тест завершён!</h1>
				<p class="text-xl text-gray-600">{ data.Quiz.Title }</p>
			</div>

			<div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
				<div class="grid grid-cols-3 gap-4 mb-6">
					<div class="text-center p-4 bg-green-50 rounded-xl">
						<p class="text-2xl font-bold text-green-600">{ data.Score }/{ data.MaxScore }</p>
						<p class="text-sm text-gray-600">Баллы</p>
					</div>
					<div class="text-center p-4 bg-green-50 rounded-xl">
						<p class="text-2xl font-bold text-green-600">{ data.CorrectCount }</p>
						<p class="text-sm text-gray-600">Правильных</p>
					</div>
					<div class="text-center p-4 bg-red-50 rounded-xl">
						<p class="text-2xl font-bold text-red-600">{ data.WrongCount }</p>
						<p class="text-sm text-gray-600">Ошибок</p>
					</div>
				</div>

				<div class="mb-4 text-center">
					<span class="text-lg font-semibold">
						Результат: { floatToPercent(data.Score, data.MaxScore) }%
					</span>
				</div>

				<a
					href="/dashboard"
					class="block w-full py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition text-center"
				>
					Вернуться к тестам
				</a>
			</div>

			<div class="bg-white rounded-2xl shadow-xl p-8">
				<h2 class="text-xl font-bold mb-4">Детализация ответов</h2>
				<div class="space-y-4">
					for i, answer := range data.Answers {
						<div class={ "p-4 rounded-xl border " + ternary(answer.IsCorrect, "bg-green-50 border-green-200", "bg-red-50 border-red-200") }>
							<div class="flex justify-between items-start mb-2">
								<span class="font-medium">Вопрос { i + 1 }</span>
								if answer.IsCorrect {
									<span class="px-2 py-1 bg-green-100 text-green-700 text-sm rounded-full">
										<i class="fas fa-check mr-1"></i>Правильно
									</span>
								} else {
									<span class="px-2 py-1 bg-red-100 text-red-700 text-sm rounded-full">
										<i class="fas fa-times mr-1"></i>Ошибка
									</span>
								}
							</div>
							<p class="text-gray-700 mb-2">{ answer.Question }</p>
							<div class="grid grid-cols-2 gap-4 text-sm">
								<div>
									<span class="text-gray-500">Ваш ответ: </span>
									<span class={ "font-medium " + ternary(answer.IsCorrect, "text-green-700", "text-red-700") }>{ answer.UserAnswer }</span>
								</div>
								if !answer.IsCorrect {
									<div>
										<span class="text-gray-500">Правильный: </span>
										<span class="font-medium text-green-700">{ answer.CorrectAnswer }</span>
									</div>
								}
							</div>
						</div>
					}
				</div>
			</div>
		</main>
	}
}

func floatToPercent(score int, maxScore int) string {
	if maxScore == 0 {
		return "0"
	}
	percent := (score * 100) / maxScore
	return fmt.Sprintf("%d", percent)
}

func ternary(condition bool, trueVal string, falseVal string) string {
	if condition {
		return trueVal
	}
	return falseVal
}

templ ErrorsPage(data types.ErrorsPageData) {
	@Base("Ошибки") {
		@Navbar(data.User)

		<main class="max-w-4xl mx-auto px-4 py-8">
			<h1 class="text-2xl font-bold mb-6">Ретроспектива ошибок</h1>

			if len(data.QuizErrors) == 0 {
				<div class="bg-white rounded-xl p-8 text-center">
					<div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
						<i class="fas fa-check text-3xl text-green-600"></i>
					</div>
					<h2 class="text-xl font-semibold mb-2">Отличная работа!</h2>
					<p class="text-gray-600">У вас пока нет ошибок. Продолжайте в том же духе!</p>
				</div>
			} else {
<div class="space-y-4">
				for _, qe := range data.QuizErrors {
					<div class="bg-white rounded-xl shadow-sm overflow-hidden quiz-card" data-quiz-id={ qe.Quiz.ID.String() }>
						<div class="p-5 cursor-pointer hover:bg-gray-50 flex justify-between items-center" data-action="toggle">
							<div>
								<h3 class="font-semibold text-lg">{ qe.Quiz.Title }</h3>
								<p class="text-sm text-gray-500">{ len(qe.WrongAnswers) } { plural(len(qe.WrongAnswers), "ошибка", "ошибки", "ошибок") }</p>
							</div>
							<div class="flex items-center gap-3">
								<a href={ templ.URL("/quiz?id=" + qe.Quiz.ID.String()) } class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">
									Пройти заново
								</a>
								<i class="fas fa-chevron-down text-gray-400 transition-transform"></i>
							</div>
						</div>
						<div class="errors-content hidden px-5 pb-5 border-t" id={ fmt.Sprintf("errors-%s", qe.Quiz.ID.String()) }>
							for _, wa := range qe.WrongAnswers {
								<div class="py-4 border-b last:border-b-0">
									<div class="flex justify-between items-start mb-2">
										<span class="text-sm text-gray-500">{ wa.Timestamp.Format("02.01.2006 15:04") }</span>
									</div>
									<div class="mb-2">
										<p class="text-sm text-gray-500">Ваш ответ:</p>
										<p class="text-red-600 font-medium">{ wa.UserAnswer }</p>
									</div>
									<div>
										<p class="text-sm text-gray-500">Правильный ответ:</p>
										<p class="text-green-600 font-medium">{ wa.CorrectAnswer }</p>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
			<script>
				document.querySelectorAll('.quiz-card [data-action="toggle"]').forEach(function(el) {
					el.addEventListener('click', function(e) {
						if (e.target.tagName === 'A' || e.target.closest('a')) return;
						var card = el.closest('.quiz-card');
						var content = card.querySelector('.errors-content');
						var icon = card.querySelector('.fa-chevron-down');
						content.classList.toggle('hidden');
						icon.classList.toggle('rotate-180');
					});
				});
			</script>
			}
		</main>
	}
}

templ LeaderboardPage(data types.LeaderboardPageData) {
	@Base("Таблица лидеров") {
		@Navbar(data.User)

		<main class="max-w-4xl mx-auto px-4 py-8">
			<h1 class="text-2xl font-bold mb-6">Таблица лидеров</h1>

			<div class="bg-white rounded-xl shadow-sm p-5">
				if len(data.Entries) == 0 {
					<div class="text-center text-gray-500 py-8">
						<p>Пока нет участников</p>
					</div>
				} else {
					<div class="space-y-3">
						for i, entry := range data.Entries {
							@FullLeaderboardRow(entry, i+1)
						}
					</div>
				}
			</div>
		</main>
	}
}

templ FullLeaderboardRow(entry *models.LeaderboardEntry, position int) {
	<div class={ RowClass(position) }>
		<div class={ PositionClass(position) }>
			{ position }
		</div>
		<div class="flex-1">
			<p class="font-semibold text-lg">{ entry.UserName }</p>
			<p class="text-sm text-gray-500">
				<i class="fas fa-fire mr-1"></i>{ entry.Streak } дней streak
			</p>
		</div>
		<div class="text-right">
			<p class="text-2xl font-bold text-indigo-600">{ entry.XP }</p>
			<p class="text-sm text-gray-500">XP</p>
		</div>
	</div>
}
